    }
    function codewordsToBits(codewords, remainderBits){
      const bits=[];
      for (const c of codewords) for(let j=7;j>=0;j--) bits.push((c>>j)&1);
      for (let i=0;i<remainderBits;i++) bits.push(0);
      return bits;
    }
    
    function makeMatrix(version){
      const size = 17+4*version;
      const m = [], reserved=[];
      for (let i=0;i<size;i++){ m.push(new Array(size).fill(null)); reserved.push(new Array(size).fill(false)); }
      return {size:size, m:m, reserved:reserved};
    }
    function setModule(ctx, r, c, val, isReserved){
      ctx.m[r][c]=val;
      if (isReserved) ctx.reserved[r][c]=true;
    }
    function placeFinder(ctx, r0, c0){
      for (let r=-1;r<=7;r++){
        for (let c=-1;c<=7;c++){
