        setModule(ctx, r, ctx.size-11+c, 0, true);
        setModule(ctx, ctx.size-11+c, r, 0, true);
      }
    }
    function bchFormat(data5){
      let g = 0b10100110111;
      let val = data5 << 10;
      let msbPos = 14;
      while (msbPos >= 10){
        if ((val >> msbPos) & 1){ val ^= (g << (msbPos-10)); }
        msbPos--;
      }
      const bch = val & 0x3FF;
      let full = (data5<<10) | bch;
      full ^= 0b101010000010010;
      return full;
    }
    function bchVersion(data6){
      let g = 0b1111100100101;
      let val = data6 << 12;
      let msbPos = 17;
      while (msbPos >= 12){
        if ((val>>msbPos)&1){ val ^= (g << (msbPos-12)); }
        msbPos--;
      }
      const bch = val & 0xFFF;
      return (data6<<12)|bch;
