---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="صانع الكيو آر كود الطبي المجاني">
  <div class="qrgen-root">

    <header class="tool-header" data-i18n>
      <h1 class="heading-font">
        <span class="lang-ar">صانع الكود الطبي <span>المجاني</span></span>
        <span class="lang-en">Free Medical <span>QR</span> Code Generator</span>
      </h1>
      <p class="tagline" data-i18n data-en="Create a QR code with your essential medical information for emergencies" data-ar="أنشئ كيو آر كود يحتوي على معلوماتك الطبية الأساسية لحالات الطوارئ">أنشئ كيو آر كود يحتوي على معلوماتك الطبية الأساسية لحالات الطوارئ</p>
      <div class="knot-divider" aria-hidden="true">
        <span class="knot-line"></span>
        <svg width="26" height="22" viewBox="0 0 26 22">
          <g fill="none" stroke="#B4872B" stroke-width="1.3">
            <path d="M13 1 L24 11 L13 21 L2 11 Z"></path>
            <path d="M13 6 L19 11 L13 16 L7 11 Z"></path>
          </g>
        </svg>
        <span class="knot-line"></span>
      </div>
      <div class="privacy-note" data-i18n data-en="Everything runs in your browser only — no uploads, no storage, no server calls" data-ar="كل شيء يعمل في متصفحك فقط — لا يتم رفع أو تخزين أي بيانات"></div>
    </header>

    <div class="qrgen-cta-row">
      <a class="btn btn-outline" href="/url-cleaner" data-i18n data-en="Clean tracking tags from any URL" data-ar="نظّف الرابط من رموز التتبع">نظّف الرابط من رموز التتبع</a>
      <a class="btn btn-gold" href="/published-apps" data-i18n data-en="Explore our health tool suite" data-ar="استكشف أدواتنا الصحية">استكشف أدواتنا الصحية</a>
    </div>

    <main class="tool-main">
      <section class="panel" aria-label="Controls">
    
        <div class="field">
          <label for="urlInput" data-i18n data-en="Link or text" data-ar="الرابط أو النص">الرابط أو النص</label>
          <input type="url" id="urlInput" placeholder="https://example.com" autocomplete="off" spellcheck="false">
          <div class="hint" id="capacityHint" data-i18n data-en="Type a link to generate the code instantly" data-ar="اكتب الرابط لتوليد الكود فوراً">اكتب الرابط لتوليد الكود فوراً</div>
        </div>
    
        <fieldset>
          <legend data-i18n data-en="Logo or image in the center of the code (optional)" data-ar="شعار أو صورة في وسط الكود (اختياري)">شعار أو صورة في وسط الكود (اختياري)</legend>
          <div class="upload-box" id="uploadBox">
            <span data-i18n data-en="📎 Click to choose an image or drag it here" data-ar="📎 انقر لاختيار صورة أو اسحبها إلى هنا">📎 انقر لاختيار صورة أو اسحبها إلى هنا</span>
            <input type="file" id="logoInput" accept="image/*">
          </div>
          <div class="upload-preview" id="logoPreview" style="display:none;">
            <img id="logoImg" alt="">
            <span id="logoName" style="font-size:12.5px;"></span>
            <button id="removeLogo" type="button" data-i18n data-en="Remove" data-ar="إزالة">إزالة</button>
          </div>
          <div class="field" style="margin-top:14px; margin-bottom:0;">
            <label data-i18n data-en="Logo size" data-ar="حجم الشعار">حجم الشعار</label>
            <input type="range" id="logoSize" min="10" max="25" value="18">
          </div>
        </fieldset>
    
        <fieldset>
          <legend data-i18n data-en="Colors" data-ar="الألوان">الألوان</legend>
          <div class="row">
            <div class="color-field">
              <input type="color" id="colorDots" value="#123832">
              <span class="swatch-name" data-i18n data-en="Dot color" data-ar="لون النقاط">لون النقاط</span>
            </div>
            <div class="color-field">
              <input type="color" id="colorBg" value="#ffffff">
              <span class="swatch-name" data-i18n data-en="Background" data-ar="الخلفية">الخلفية</span>
            </div>
          </div>
        </fieldset>
    
        <fieldset>
          <legend data-i18n data-en="Dot shape" data-ar="شكل النقاط">شكل النقاط</legend>
          <div class="seg" id="dotShapeSeg">
            <button data-val="square" class="active" data-i18n data-en="Square" data-ar="مربع">مربع</button>
            <button data-val="rounded" data-i18n data-en="Soft" data-ar="ناعم">ناعم</button>
            <button data-val="dot" data-i18n data-en="Round" data-ar="دائري">دائري</button>
          </div>
        </fieldset>
    
        <fieldset>
          <legend data-i18n data-en="Outer frame" data-ar="الإطار الخارجي">الإطار الخارجي</legend>
          <div class="seg" id="frameStyleSeg">
            <button data-val="none" data-i18n data-en="None" data-ar="بدون">بدون</button>
            <button data-val="line" class="active" data-i18n data-en="Simple line" data-ar="خط بسيط">خط بسيط</button>
            <button data-val="double" data-i18n data-en="Double" data-ar="مزدوج">مزدوج</button>
            <button data-val="ornate" data-i18n data-en="Ornate" data-ar="مزخرف">مزخرف</button>
            <button data-val="dashed" data-i18n data-en="Dashed" data-ar="متقطع">متقطع</button>
          </div>
          <div class="row" style="margin-top:14px;">
            <div class="color-field">
              <input type="color" id="colorFrame" value="#B4872B">
              <span class="swatch-name" data-i18n data-en="Frame color" data-ar="لون الإطار">لون الإطار</span>
            </div>
          </div>
        </fieldset>
    
        <div class="field">
          <label for="captionInput" data-i18n data-en="Caption inside the frame (optional)" data-ar="نص داخل الإطار (اختياري)">نص داخل الإطار (اختياري)</label>
          <input type="text" id="captionInput" placeholder="امسح الكود لزيارة موقعنا" maxlength="60">
        </div>
    
      </section>
    
      <section class="panel preview-panel" aria-label="Preview">
        <div class="canvas-wrap">
          <canvas id="qrCanvas" width="600" height="600"></canvas>
        </div>
        <div class="status" id="statusLine"></div>
        <div class="actions">
          <button class="btn btn-primary" id="btnPng" data-i18n data-en="Download PNG" data-ar="تحميل PNG">تحميل PNG</button>
          <button class="btn btn-gold" id="btnSvg" data-i18n data-en="Download SVG" data-ar="تحميل SVG">تحميل SVG</button>
          <button class="btn btn-outline" id="btnCopy" data-i18n data-en="Copy image" data-ar="نسخ الصورة">نسخ الصورة</button>
        </div>
        <div class="meta-line" id="metaLine"></div>
      </section>
    </main>
    
    <footer class="tool-footer">
      <p data-i18n data-en="Works fully offline once loaded — you can save this page and open it from your device anytime." data-ar="يعمل بدون انترنت بعد تحميله — يمكنك حفظ هذه الصفحة وفتحها من جهازك في أي وقت.">يعمل بدون انترنت بعد تحميله — يمكنك حفظ هذه الصفحة وفتحها من جهازك في أي وقت.</p>
    </footer>
    
    <div class="toast" id="toast"></div>
  </div>

  <article class="article-section">
    <div class="article-content" data-i18n>
      <div class="lang-ar">
        <h2>دليل صانع الرموز الطبية والخدمية الذكي</h2>
        <h3>صانع الرموز الطبية الذكي: حلول مجانية وسريعة للقطاع الصحي والممارسين</h3>
        <p>في عصر التحول الرقمي والتكنولوجيا الصحية، أصبحت السرعة، الدقة، وبساطة التواصل هي أعمدة الرعاية الطبية الناجحة. يُعد صانع الرموز الطبية (Medical QR Code Generator) أحد أبرز الأدوات الرقمية الحديثة التي تسهل على الأطباء، الصيادلة، والمؤسسات الصحية ربط المرضى بالمعلومات والخدمات الطبية بلمسة واحدة ومن دون أي تعقيد.</p>
        <p>سواء كنت تجري استشارة، أو تطبع ملصقاً توعوياً، أو تود مشاركة تعليمات استخدام الدواء مع المريض، فإن أداة إنشاء الرموز الطبية تتيح لك تحويل أي نص أو رابط إلى رمز استجابة سريعة (QR Code) آمن، سريع، ومجاني بالكامل.</p>
        <h4>لماذا يحتاج القطاع الصحي إلى صانع الرموز الطبية؟</h4>
        <p>تستدعي بيئة العمل في المستشفيات والعيادات التعامل مع مئات التفاصيل يومياً. استخدام الرموز الاستجابة السريعة يساهم في:</p>
        <ul>
          <li><b>تيسير الوصول للوصفات والتعليمات الطبية:</b> إرفاق رمز الاستجابة على ملف المريض أو الوصفة الطبية لفتح جدول الجرعات أو النصائح الغذائية.</li>
          <li><b>الوصول السريع لملفات الطوارئ (Emergency Medical ID):</b> تمكين المرضى من طباعة رمز يحتوي على فصيلة الدم، الحساسيات الدوائية، وأرقام التواصل في حالات الطوارئ.</li>
          <li><b>دعم المؤتمرات والأبحاث الطبية:</b> تمكين المحاضرين والأطباء من مشاركة العروض التقديمية والبحوث العلمية مع زملائهم بضغطة زر.</li>
          <li><b>توفير الوقت والحد من الأخطاء البشرية:</b> تقليل الحاجة لكتابة الروابط الطبية الطويلة أو الاستشارات المفصلة يدوياً.</li>
        </ul>
        <h4>مميزات مخصصة للتميز والتصميم الاحترافي</h4>
        <p>تتميز أداتنا المجانية بتقديم خيارات تخصيص تقدمية لتناسب الهوية البصرية لعيادتك أو مركزك الطبي:</p>
        <ul>
          <li><b>إضافة الشعار الخاص بك (Custom Logo):</b> يمكنك إدراج شعار العيادة، الصيدلية، أو رمز الهلال/الصليب الطبي في منتصف الكود لرفع مستوى الموثوقية والأمان لدى المريض.</li>
          <li><b>اختيار الأشكال الفنية والحواف (Custom Shapes & Design):</b> تخصيص أشكال النقاط والزوايا الداخلية والخارجية لتمنح الرمز لمسة فنية حديثة تبتعد عن الشكل التقليدي الجاف.</li>
          <li><b>إضافة الإطارات والعبارات التشجيعية (Custom Frames):</b> إضافة إطار خارجي يحمل عبارات توضيحية للمريض مثل: "امسح الكود لمعرفة الجرعات" أو "Scan for Medical Info" لزيادة نسبة تفاعل الزوار.</li>
          <li><b>تغيير الألوان والتباين (Color Control):</b> التحكم الكامل بألوان خلفية ونقاط الرمز لتتماشى مع ألوان الهوية البصرية لمؤسستك الصحية.</li>
        </ul>
        <h4>الأمان والخصوصية: حماية بياناتك أولاً</h4>
        <p>تعتمد أداتنا البرمجية على المعالجة الفورية المباشرة على متصفح المستخدم (Client-Side Processing). هذا يعني أن النصوص، البيانات، أو الروابط التي تحولها إلى رمز لا تُحفظ في أي قواعد بيانات خارجية أو سيرفرات، مما يضمن أعلى مستويات الخصوصية والامتثال لمعايير الأمان الطبي وتداول البيانات الحساسة.</p>
        <h4>خدمة مجانية 100% وغير محدودة للأبد</h4>
        <p>دعماً للكوادر الطبية والممارسين الصحيين في كل مكان، نتيح هذه الأداة بشكل مجاني بالكامل، دون الحاجة للتسجيل، ودون فرض أي حد أقصى لعدد مرات الإنشاء اليومي.</p>
      </div>
      <div class="lang-en">
        <h2>Medical QR Code Generator Guide</h2>
        <h3>Smart Medical QR Code Generator: Free & Secure Solutions for Healthcare Providers</h3>
        <p>In the era of digital health transformation, speed, accuracy, and seamless communication form the backbone of effective medical care. The Medical QR Code Generator is a powerful utility designed to bridge the gap between healthcare professionals, patients, and vital medical information with a single scan.</p>
        <p>Whether you are conducting a clinical consultation, designing a public health poster, or sharing medication guidelines with patients, our tool turns any text, URL, or instruction into an instant, highly secure QR code—completely free of charge.</p>
        <h4>Why Healthcare Professionals Need a Medical QR Generator</h4>
        <p>The fast-paced nature of medical environments requires tools that reduce friction and eliminate errors:</p>
        <ul>
          <li><b>Instant Patient Education:</b> Attach QR codes to prescription sheets or medical files leading to dosage guides, dietary advice, or workout routines.</li>
          <li><b>Emergency Medical IDs:</b> Allow patients to create and carry printable QR codes containing crucial info such as blood type, drug allergies, and emergency contacts.</li>
          <li><b>Medical Research & Conferences:</b> Enable doctors, professors, and researchers to instantly share scientific papers and presentation slides during medical conventions.</li>
          <li><b>Streamlined Practice Management:</b> Direct patients effortlessly to online booking portals, clinic locations, or feedback forms.</li>
        </ul>
        <h4>Advanced Design & Customization Features</h4>
        <p>Our generator offers full creative control to help your medical practice maintain a crisp, professional brand identity:</p>
        <ul>
          <li><b>Custom Logo Integration:</b> Insert your clinic, hospital, or pharmacy logo right at the center of the QR code to build patient trust and brand recognition.</li>
          <li><b>Artistic Shapes & Patterns:</b> Choose from various dot patterns and corner styles to transform standard barcodes into modern, visually pleasing assets.</li>
          <li><b>Interactive Custom Frames:</b> Enclose your QR codes with tailored call-to-action frames (e.g., "Scan for Prescription Info" or "Medical Contact ID").</li>
          <li><b>Color & Contrast Customization:</b> Adjust background and foreground colors to seamlessly match your organization's official branding.</li>
        </ul>
        <h4>Privacy First: Client-Side Security</h4>
        <p>We prioritize patient privacy above all else. Our tool runs entirely on Client-Side JavaScript Processing, meaning that the information or URLs you convert into QR codes are generated directly inside your browser. No medical data is ever stored, saved, or transmitted to external servers, making it fully compliant with healthcare privacy principles.</p>
        <h4>Unrestricted & Free Forever for the Medical Community</h4>
        <p>To support healthcare heroes, pharmacists, students, and practitioners worldwide, this service is provided 100% free of charge, with no account registration required and no daily generation limits. Create as many codes as you need, whenever you need them!</p>
      </div>
    </div>
  </article>

  <style>
    .qrgen-root{
      --ink:#123832;
      --ink-2:#0c2925;
      --paper:#F6F0DF;
      --paper-2:#EFE6CC;
      --gold:#B4872B;
      --gold-light:#D8AE55;
      --wine:#7C2D3B;
      --charcoal:#211F1B;
      --line: rgba(18,56,50,0.16);
      --shadow: 0 18px 40px -22px rgba(12,41,37,0.45);
      --radius: 18px;
      font-size: 16px;
      max-width: 1180px;
      margin: 0 auto;
      position: relative;
      display: block;
      box-sizing: border-box;
      background:
        radial-gradient(1200px 600px at 85% -10%, rgba(180,135,43,0.10), transparent 60%),
        radial-gradient(900px 500px at -10% 110%, rgba(124,45,59,0.08), transparent 55%),
        var(--paper);
      color: var(--charcoal);
      font-family: "Tahoma","Segoe UI","Cairo",sans-serif;
      line-height:1.6;
      direction: rtl;
    }
    .qrgen-root, .qrgen-root *{ box-sizing: border-box; }
    [lang="en"] .qrgen-root { direction: ltr; }
    .qrgen-root .heading-font{
      font-family:"Palatino Linotype","Book Antiqua",Georgia,"Times New Roman",serif;
    }
  
    /* ---------- ornamental divider (signature element) ---------- */
    .qrgen-root .knot-divider{
      width:100%;
      height:22px;
      display:flex;
      align-items:center;
      justify-content:center;
      gap:14px;
      opacity:0.85;
    }
    .qrgen-root .knot-divider svg{ display:block; }
    .qrgen-root .knot-line{ flex:1; height:1px; background: linear-gradient(90deg, transparent, var(--gold), transparent); max-width:220px; }
  
    .qrgen-root .tool-header{
      padding: 38px 24px 18px;
      text-align:center;
    }
    .qrgen-root header h1{
      font-size: clamp(28px, 4vw, 42px);
      margin: 0 0 6px;
      color: var(--ink);
      letter-spacing: 0.5px;
    }
    .qrgen-root header h1 span{ color: var(--gold); }
    .qrgen-root header p.tagline{
      margin: 6px 0 0;
      color: rgba(33,31,27,0.65);
      font-size: 15px;
    }
    .qrgen-root .privacy-note{
      display:inline-flex;
      align-items:center;
      gap:8px;
      margin-top:14px;
      padding: 7px 16px;
      border: 1px solid var(--line);
      border-radius: 999px;
      background: rgba(255,255,255,0.5);
      font-size: 13px;
      color: var(--ink);
    }
    .qrgen-root .privacy-note::before{ content:"●"; color:#3a8a5f; font-size:9px; }
  
    .qrgen-root .tool-main{
      max-width: 1180px;
      margin: 10px auto 60px;
      padding: 0 20px;
      display:grid;
      grid-template-columns: 1.05fr 1fr;
      gap: 26px;
    }
    @media (max-width: 880px){
      .qrgen-root .tool-main{ grid-template-columns: 1fr; }
    }
  
    .qrgen-root .panel{
      background: rgba(255,255,255,0.55);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding: 26px;
      backdrop-filter: blur(2px);
    }
  
    /* ---------- controls ---------- */
    .qrgen-root .field{ margin-bottom: 20px; }
    .qrgen-root .field label{
      display:block;
      font-size: 13.5px;
      font-weight:700;
      color: var(--ink);
      margin-bottom: 8px;
    }
    .qrgen-root .field .hint{
      font-size:12px;
      color: rgba(33,31,27,0.55);
      margin-top:6px;
    }
    .qrgen-root input[type="text"], .qrgen-root input[type="url"]{
      width:100%;
      padding: 12px 14px;
      border-radius: 10px;
      border: 1.5px solid var(--line);
      background: #fff;
      font-size: 15px;
      color: var(--charcoal);
      font-family: inherit;
      transition: border-color .15s;
    }
    .qrgen-root input[type="text"]:focus, .qrgen-root input[type="url"]:focus{
      outline:none;
      border-color: var(--gold);
    }
    .qrgen-root .row{ display:flex; gap:14px; }
    .qrgen-root .row > *{ flex:1; }
  
    .qrgen-root .color-field{ display:flex; align-items:center; gap:10px; }
    .qrgen-root .color-field input[type="color"]{
      width:44px; height:40px; border-radius:10px; border:1.5px solid var(--line);
      padding:2px; background:#fff; cursor:pointer;
    }
    .qrgen-root .color-field .swatch-name{ font-size:13px; color:var(--charcoal); }
  
    .qrgen-root .seg{
      display:flex;
      border: 1.5px solid var(--line);
      border-radius: 10px;
      overflow:hidden;
      background:#fff;
    }
    .qrgen-root .seg button{
      flex:1;
      padding: 9px 6px;
      border:none;
      background: transparent;
      font-family:inherit;
      font-size:13px;
      color: var(--charcoal);
      cursor:pointer;
      border-inline-start: 1px solid var(--line);
      transition: background .15s, color .15s;
    }
    .qrgen-root .seg button:first-child{ border-inline-start:none; }
    .qrgen-root .seg button.active{
      background: var(--ink);
      color: var(--paper);
    }
  
    .qrgen-root .upload-box{
      border: 1.5px dashed var(--line);
      border-radius: 12px;
      padding: 16px;
      text-align:center;
      background:#fff;
      cursor:pointer;
      font-size: 13.5px;
      color: rgba(33,31,27,0.7);
      position:relative;
    }
    .qrgen-root .upload-box:hover{ border-color: var(--gold); }
    .qrgen-root .upload-box.drag-over{ border-color: var(--gold); background: rgba(180,135,43,0.08); }
    .qrgen-root .upload-box input[type="file"]{
      position:absolute; inset:0; opacity:0; cursor:pointer;
    }
    .qrgen-root .upload-preview{
      display:flex; align-items:center; gap:12px; margin-top:10px;
    }
    .qrgen-root .upload-preview img{
      width:40px; height:40px; object-fit:cover; border-radius:8px; border:1px solid var(--line);
    }
    .qrgen-root .upload-preview button{
      border:none; background:none; color:var(--wine); font-size:12.5px; cursor:pointer; text-decoration:underline;
      font-family:inherit;
    }
  
    .qrgen-root input[type="range"]{
      width:100%; accent-color: var(--gold);
    }
  
    .qrgen-root fieldset{ border:none; padding:0; margin:0 0 20px; }
    .qrgen-root legend{
      font-size: 13.5px; font-weight:700; color:var(--ink); margin-bottom:10px; padding:0;
    }
  
    /* ---------- preview panel ---------- */
    .qrgen-root .preview-panel{
      display:flex;
      flex-direction:column;
      align-items:center;
      justify-content:flex-start;
      gap: 18px;
    }
    .qrgen-root .canvas-wrap{
      width:100%;
      display:flex;
      justify-content:center;
      padding: 10px;
      background:
        linear-gradient(rgba(255,255,255,0.4), rgba(255,255,255,0.4)),
        repeating-conic-gradient(#efe9d8 0% 25%, #f6f0df 0% 50%) 0 0/16px 16px;
      border-radius: 14px;
      border: 1px solid var(--line);
    }
    .qrgen-root #qrCanvas{
