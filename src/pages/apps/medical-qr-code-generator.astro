              const val = (mx===2||mx===0)?1:0;
              setModule(ctx, r+dr, c+dc, val, true);
            }
          }
        }
      }
    }
    function placeDarkModule(ctx, version){ setModule(ctx, 4*version+9, 8, 1, true); }
    function reserveFormatAreas(ctx){
      for (let i=0;i<9;i++){
        if (ctx.m[8][i]===null) setModule(ctx,8,i,0,true);
        if (ctx.m[i][8]===null) setModule(ctx,i,8,0,true);
      }
      // row-strip (bottom copy of format info): row 8, columns (size-8)..(size-1) — 8 modules
      for (let i=0;i<8;i++){
        setModule(ctx, 8, ctx.size-8+i, 0, true);
      }
      // col-strip (right copy of format info): column 8, rows (size-7)..(size-1) — 7 modules.
      // Row (size-8) is deliberately NOT part of this strip: that cell belongs to the
      // dark module, and previously this loop over-reserved it, causing placeFormatInfo
      // to later overwrite the dark module with a stray format-info bit.
      for (let i=0;i<7;i++){
