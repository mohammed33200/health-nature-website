    const TABLE = {
    1:{L:[19,7,[[1,19]]], M:[16,10,[[1,16]]], Q:[13,13,[[1,13]]], H:[9,17,[[1,9]]]},
    2:{L:[34,10,[[1,34]]], M:[28,16,[[1,28]]], Q:[22,22,[[1,22]]], H:[16,28,[[1,16]]]},
    3:{L:[55,15,[[1,55]]], M:[44,26,[[1,44]]], Q:[34,18,[[2,17]]], H:[26,22,[[2,13]]]},
    4:{L:[80,20,[[1,80]]], M:[64,18,[[2,32]]], Q:[48,26,[[2,24]]], H:[36,16,[[4,9]]]},
    5:{L:[108,26,[[1,108]]], M:[86,24,[[2,43]]], Q:[62,18,[[2,15],[2,16]]], H:[46,22,[[2,11],[2,12]]]},
    6:{L:[136,18,[[2,68]]], M:[108,16,[[4,27]]], Q:[76,24,[[4,19]]], H:[60,28,[[4,15]]]},
    7:{L:[156,20,[[2,78]]], M:[124,18,[[4,31]]], Q:[88,18,[[2,14],[4,15]]], H:[66,26,[[4,13],[1,14]]]},
    8:{L:[194,24,[[2,97]]], M:[154,22,[[2,38],[2,39]]], Q:[110,22,[[4,18],[2,19]]], H:[86,26,[[4,14],[2,15]]]},
