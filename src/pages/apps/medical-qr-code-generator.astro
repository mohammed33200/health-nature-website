      dotShape: 'square',
      frameStyle: 'line',
      logoImage: null
    };
    let lastResult = null; // {matrix, size, moduleSize, quiet, frameStyle, ...} for export reuse
    
    function showToast(msg){
      toast.textContent = msg;
      toast.classList.add('show');
      setTimeout(()=> toast.classList.remove('show'), 1800);
    }
    
    // ---- segmented controls ----
    function bindSeg(seg, onChange){
      seg.querySelectorAll('button').forEach(btn=>{
        btn.addEventListener('click', ()=>{
          seg.querySelectorAll('button').forEach(b=>b.classList.remove('active'));
          btn.classList.add('active');
          onChange(btn.dataset.val);
        });
      });
    }
    bindSeg(dotShapeSeg, (v)=> { state.dotShape=v; render(); });
    bindSeg(frameStyleSeg, (v)=> { state.frameStyle=v; render(); });
    
    // ---- logo upload ----
    function loadLogoFile(file){
      if (!file || !file.type || !file.type.startsWith('image/')) return;
      const reader = new FileReader();
      reader.onload = (ev)=>{
        const dataUrl = /** @type {string} */ (ev.target?.result);
        const img = new Image();
        img.onload = ()=>{
          state.logoImage = img;
          logoImgEl.src = dataUrl;
          if(logoName) logoName.textContent = file.name.length>18? file.name.slice(0,16)+'…' : file.name;
          logoPreview.style.display='flex';
          render();
        };
        img.src = dataUrl;
      };
      reader.readAsDataURL(file);
    }
    logoInput.addEventListener('change', (e)=>{
      const input = /** @type {HTMLInputElement} */ (e.target);
      if (input.files) loadLogoFile(input.files[0]);
    });
    ;['dragenter','dragover'].forEach(evt=>{
      uploadBox.addEventListener(evt, (e)=>{
        e.preventDefault(); e.stopPropagation();
        uploadBox.classList.add('drag-over');
      });
    });
    ;['dragleave','drop'].forEach(evt=>{
      uploadBox.addEventListener(evt, (e)=>{
        e.preventDefault(); e.stopPropagation();
        uploadBox.classList.remove('drag-over');
      });
    });
    uploadBox.addEventListener('drop', (e)=>{
      const file = e.dataTransfer?.files?.[0];
      if (file) loadLogoFile(file);
    });
    removeLogoBtn.addEventListener('click', ()=>{
      state.logoImage = null;
      logoInput.value = '';
      logoPreview.style.display='none';
      render();
    });
    
    [urlInput, captionInput, colorDots, colorBg, colorFrame, logoSize].forEach(el=>{
      el.addEventListener('input', render);
    });
    
    // ---- core render ----
    function render(){
      const text = urlInput.value.trim();
      if (!text){
        ctx2d.clearRect(0,0,canvas.width,canvas.height);
        statusLine.textContent = '';
        statusLine.className = 'status';
        metaLine.textContent = '';
        capacityHint.textContent = 'اكتب الرابط لتوليد الكود فوراً';
        setExportEnabled(false);
        lastResult = null;
        return;
      }
    
      const level = state.logoImage ? 'H' : 'M';
      const result = window.QRGen.generateMatrix(text, level);
      if (!result){
        statusLine.textContent = 'النص طويل جداً — حاول تقصير الرابط';
        statusLine.className = 'status error';
        metaLine.textContent = '';
        setExportEnabled(false);
        lastResult = null;
        return;
      }
      statusLine.textContent = '✓ الكود جاهز ويعمل';
      statusLine.className = 'status ok';
      metaLine.textContent = 'إصدار ' + result.version + ' — تصحيح خطأ ' + result.level +
        (state.logoImage ? ' (تم رفعه تلقائياً لدعم الشعار)' : '');
      capacityHint.textContent = TABLE_HINT(text.length);
    
      const opts = {
        dotColor: colorDots.value,
        bgColor: colorBg.value,
        frameColor: colorFrame.value,
        frameStyle: state.frameStyle,
        dotShape: state.dotShape,
        caption: captionInput.value.trim(),
        logo: state.logoImage,
        logoSizePct: parseInt(logoSize.value,10)
      };
      drawToCanvas(result, opts, canvas, ctx2d);
      lastResult = {result, opts};
      setExportEnabled(true);
    }
    
    function TABLE_HINT(len){
      if (len < 40) return 'طول ممتاز — كود بسيط وسريع المسح';
      if (len < 120) return 'طول جيد — سيبقى الكود واضحاً';
      return 'رابط طويل — تقصيره سيجعل الكود أقل كثافة';
    }
    
    function setExportEnabled(on){
      btnPng.disabled = !on;
      btnSvg.disabled = !on;
      btnCopy.disabled = !on;
    }
    
    // ---- drawing geometry ----
    const QUIET = 4; // quiet zone modules (ISO minimum is 4 — never reduce this)
    const MODULE_PX = 10;
    const FRAME_PAD = 46; // px padding for frame/caption area
    
    function computeLayout(result, opts){
      const n = result.size;
      const qrPx = (n + QUIET*2) * MODULE_PX;
      const hasFrame = opts.frameStyle !== 'none';
      const hasCaption = !!opts.caption;
      const framePad = hasFrame ? FRAME_PAD : 12;
      const captionH = hasCaption ? 44 : 0;
      const total = qrPx + framePad*2 + captionH;
      return { n, qrPx, framePad, captionH, total, px: MODULE_PX };
    }
    
    function roundedRectPath(ctx, x, y, w, h, r){
      ctx.beginPath();
      ctx.moveTo(x+r, y);
      ctx.arcTo(x+w, y, x+w, y+h, r);
      ctx.arcTo(x+w, y+h, x, y+h, r);
      ctx.arcTo(x, y+h, x, y, r);
      ctx.arcTo(x, y, x+w, y, r);
      ctx.closePath();
    }
    
    function drawFinderAware(matrix, n){
      // mark which modules belong to the 3 finder-pattern 7x7 blocks (for special corner styling)
      const isFinder = (r,c)=>{
        return (r<7 && c<7) || (r<7 && c>=n-7) || (r>=n-7 && c<7);
      };
      return isFinder;
    }
    
    function drawToCanvas(result, opts, cnv, c){
      const { n, qrPx, framePad, captionH, total, px } = computeLayout(result, opts);
      cnv.width = total; cnv.height = total;
      c.clearRect(0,0,total,total);
    
      // outer background (page behind frame)
      c.fillStyle = '#ffffff';
      c.fillRect(0,0,total,total);
    
      const qrX = framePad, qrY = framePad;
    
      // qr background
      c.fillStyle = opts.bgColor;
      c.fillRect(qrX, qrY, qrPx, qrPx);
    
      const isFinder = drawFinderAware(result.matrix, n);
      c.fillStyle = opts.dotColor;
    
      for (let r=0;r<n;r++){
        for (let col=0; col<n; col++){
          if (!result.matrix[r][col]) continue;
          const x = qrX + (QUIET+col)*px;
          const y = qrY + (QUIET+r)*px;
          if (isFinder(r,col)){
            c.fillRect(x,y,px,px); // finder patterns stay solid squares for reliable detection
            continue;
          }
          drawDot(c, x, y, px, opts.dotShape);
        }
      }
    
      // logo overlay — sized relative to the actual QR data area (excludes the quiet
      // zone) so the percentage always maps to the same real obstruction ratio,
      // and capped at 25% which stays safely inside the ~30% recovery budget of
      // error-correction level H once you account for the white backing plate.
      if (opts.logo){
        const dataPx = n * px;
        const pct = Math.min(25, Math.max(10, opts.logoSizePct)) / 100;
        const logoPx = dataPx * pct;
        const lx = qrX + (qrPx-logoPx)/2;
        const ly = qrY + (qrPx-logoPx)/2;
        const pad = logoPx*0.14;
        c.save();
        roundedRectPath(c, lx-pad, ly-pad, logoPx+pad*2, logoPx+pad*2, 12);
        c.fillStyle = opts.bgColor;
        c.fill();
        c.restore();
        c.save();
        roundedRectPath(c, lx, ly, logoPx, logoPx, 10);
        c.clip();
        c.drawImage(opts.logo, lx, ly, logoPx, logoPx);
        c.restore();
      }
    
      // frame
      if (opts.frameStyle !== 'none'){
        drawFrame(c, framePad*0.35, framePad*0.35, total-framePad*0.7, total-framePad*0.7-captionH, opts.frameColor, opts.frameStyle);
      }
    
      // caption
      if (opts.caption){
        c.fillStyle = opts.frameColor;
        c.font = '600 20px Tahoma, "Segoe UI", sans-serif';
        c.textAlign = 'center';
        c.textBaseline = 'middle';
        c.direction = 'ltr';
        c.fillText(opts.caption, total/2, total - captionH/2 - framePad*0.12, total-framePad*1.2);
      }
    }
    
    function drawDot(c, x, y, px, shape){
      if (shape==='square'){
        c.fillRect(x,y,px,px);
      } else if (shape==='rounded'){
        roundedRectPath(c, x+px*0.08, y+px*0.08, px*0.84, px*0.84, px*0.28);
        c.fill();
      } else { // dot
        c.beginPath();
        c.arc(x+px/2, y+px/2, px*0.42, 0, Math.PI*2);
        c.fill();
      }
    }
    
    function drawFrame(c, x, y, w, h, color, style){
      c.save();
      c.strokeStyle = color;
      if (style==='line'){
        c.lineWidth = 4;
        c.strokeRect(x+2, y+2, w-4, h-4);
      } else if (style==='double'){
        c.lineWidth = 3;
        c.strokeRect(x+2, y+2, w-4, h-4);
        c.strokeRect(x+10, y+10, w-20, h-20);
      } else if (style==='dashed'){
        c.lineWidth = 4;
        c.setLineDash([14,10]);
        c.strokeRect(x+2, y+2, w-4, h-4);
        c.setLineDash([]);
      } else if (style==='ornate'){
        c.lineWidth = 3;
        c.strokeRect(x+6, y+6, w-12, h-12);
        const cornerLen = Math.min(38, w*0.14);
        drawCorner(c, x, y, cornerLen, 0, color);
        drawCorner(c, x+w, y, cornerLen, 1, color);
        drawCorner(c, x, y+h, cornerLen, 2, color);
        drawCorner(c, x+w, y+h, cornerLen, 3, color);
        // small diamond accents mid-edges
        drawDiamond(c, x+w/2, y+3, color);
        drawDiamond(c, x+w/2, y+h-3, color);
        drawDiamond(c, x+3, y+h/2, color);
        drawDiamond(c, x+w-3, y+h/2, color);
      }
      c.restore();
    }
    function drawCorner(c, x, y, len, corner, color){
      c.save();
      c.strokeStyle = color;
      c.lineWidth = 5;
      c.lineCap = 'round';
      c.beginPath();
      if (corner===0){ c.moveTo(x, y+len); c.lineTo(x,y); c.lineTo(x+len,y); }
      if (corner===1){ c.moveTo(x-len, y); c.lineTo(x,y); c.lineTo(x,y+len); }
      if (corner===2){ c.moveTo(x, y-len); c.lineTo(x,y); c.lineTo(x+len,y); }
      if (corner===3){ c.moveTo(x-len, y); c.lineTo(x,y); c.lineTo(x,y-len); }
      c.stroke();
      c.restore();
    }
    function drawDiamond(c, x, y, color){
      const s=6;
      c.save();
      c.fillStyle = color;
      c.beginPath();
      c.moveTo(x, y-s); c.lineTo(x+s, y); c.lineTo(x, y+s); c.lineTo(x-s, y);
      c.closePath(); c.fill();
      c.restore();
    }
    
    // ---- SVG export ----
    function buildSVG(result, opts){
      const { n, qrPx, framePad, captionH, total, px } = computeLayout(result, opts);
      const qrX = framePad, qrY = framePad;
      const isFinder = drawFinderAware(result.matrix, n);
      let paths = '';
      for (let r=0;r<n;r++){
        for (let col=0; col<n; col++){
          if (!result.matrix[r][col]) continue;
          const x = qrX + (QUIET+col)*px;
          const y = qrY + (QUIET+r)*px;
          if (isFinder(r,col) || opts.dotShape==='square'){
            paths += `<rect x="${x}" y="${y}" width="${px}" height="${px}" fill="${opts.dotColor}"/>`;
          } else if (opts.dotShape==='rounded'){
            const rr = px*0.28;
            paths += `<rect x="${x+px*0.08}" y="${y+px*0.08}" width="${px*0.84}" height="${px*0.84}" rx="${rr}" fill="${opts.dotColor}"/>`;
          } else {
            paths += `<circle cx="${x+px/2}" cy="${y+px/2}" r="${px*0.42}" fill="${opts.dotColor}"/>`;
          }
        }
      }
      let logoSvg = '';
      if (opts.logo){
        const dataPx = n * px;
        const pct = Math.min(25, Math.max(10, opts.logoSizePct)) / 100;
        const logoPx = dataPx * pct;
        const lx = qrX + (qrPx-logoPx)/2;
        const ly = qrY + (qrPx-logoPx)/2;
        const pad = logoPx*0.14;
        const dataUrl = opts.logoDataUrl || '';
        logoSvg = `<rect x="${lx-pad}" y="${ly-pad}" width="${logoPx+pad*2}" height="${logoPx+pad*2}" rx="12" fill="${opts.bgColor}"/>` +
          (dataUrl ? `<image href="${dataUrl}" x="${lx}" y="${ly}" width="${logoPx}" height="${logoPx}" preserveAspectRatio="xMidYMid slice"/>` : '');
      }
      let frameSvg = '';
      if (opts.frameStyle !== 'none'){
        const x=framePad*0.35, y=framePad*0.35, w=total-framePad*0.7, h=total-framePad*0.7-captionH;
        if (opts.frameStyle==='line'){
          frameSvg = `<rect x="${x+2}" y="${y+2}" width="${w-4}" height="${h-4}" fill="none" stroke="${opts.frameColor}" stroke-width="4"/>`;
        } else if (opts.frameStyle==='double'){
          frameSvg = `<rect x="${x+2}" y="${y+2}" width="${w-4}" height="${h-4}" fill="none" stroke="${opts.frameColor}" stroke-width="3"/>` +
                     `<rect x="${x+10}" y="${y+10}" width="${w-20}" height="${h-20}" fill="none" stroke="${opts.frameColor}" stroke-width="3"/>`;
        } else if (opts.frameStyle==='dashed'){
          frameSvg = `<rect x="${x+2}" y="${y+2}" width="${w-4}" height="${h-4}" fill="none" stroke="${opts.frameColor}" stroke-width="4" stroke-dasharray="14,10"/>`;
        } else if (opts.frameStyle==='ornate'){
          const cl = Math.min(38, w*0.14);
          frameSvg = `<rect x="${x+6}" y="${y+6}" width="${w-12}" height="${h-12}" fill="none" stroke="${opts.frameColor}" stroke-width="3"/>`;
          const corners = [
            `M ${x} ${y+cl} L ${x} ${y} L ${x+cl} ${y}`,
            `M ${x+w-cl} ${y} L ${x+w} ${y} L ${x+w} ${y+cl}`,
            `M ${x} ${y+h-cl} L ${x} ${y+h} L ${x+cl} ${y+h}`,
            `M ${x+w-cl} ${y+h} L ${x+w} ${y+h} L ${x+w} ${y+h-cl}`
          ];
          for (const d of corners){
            frameSvg += `<path d="${d}" fill="none" stroke="${opts.frameColor}" stroke-width="5" stroke-linecap="round"/>`;
          }
          const diamonds = [[x+w/2,y],[x+w/2,y+h],[x,y+h/2],[x+w,y+h/2]];
          for (const [dx,dy] of diamonds){
            frameSvg += `<polygon points="${dx},${dy-6} ${dx+6},${dy} ${dx},${dy+6} ${dx-6},${dy}" fill="${opts.frameColor}"/>`;
          }
        }
      }
      let captionSvg = '';
      if (opts.caption){
        captionSvg = `<text x="${total/2}" y="${total - captionH/2 - framePad*0.12}" text-anchor="middle" dominant-baseline="middle" font-family="Tahoma, Segoe UI, sans-serif" font-size="20" font-weight="600" fill="${opts.frameColor}" direction="ltr">${escapeXml(opts.caption)}</text>`;
      }
    
      return `<svg xmlns="http://www.w3.org/2000/svg" width="${total}" height="${total}" viewBox="0 0 ${total} ${total}">` +
        `<rect width="${total}" height="${total}" fill="#ffffff"/>` +
        `<rect x="${qrX}" y="${qrY}" width="${qrPx}" height="${qrPx}" fill="${opts.bgColor}"/>` +
        paths + logoSvg + frameSvg + captionSvg +
        `</svg>`;
    }
    function escapeXml(s){
      return s.replace(/[<>&'"]/g, ch => ({'<':'&lt;','>':'&gt;','&':'&amp;',"'":'&apos;','"':'&quot;'}[ch]));
    }
    
    // ---- export handlers ----
    btnPng.addEventListener('click', ()=>{
      if (!lastResult) return;
      canvas.toBlob((blob)=>{
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'qr-code.png';
        a.click();
        showToast('تم تحميل صورة PNG');
      }, 'image/png');
    });
    
    btnSvg.addEventListener('click', ()=>{
      if (!lastResult) return;
      const opts = Object.assign({}, lastResult.opts);
      if (opts.logo){ opts.logoDataUrl = logoImgEl.src; }
      const svg = buildSVG(lastResult.result, opts);
      const blob = new Blob([svg], {type:'image/svg+xml'});
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'qr-code.svg';
      a.click();
      showToast('تم تحميل ملف SVG');
    });
    
    btnCopy.addEventListener('click', async ()=>{
      if (!lastResult) return;
      try{
        canvas.toBlob(async (blob)=>{
          await navigator.clipboard.write([ new ClipboardItem({'image/png': blob}) ]);
          showToast('تم نسخ الصورة إلى الحافظة');
        }, 'image/png');
      }catch(err){
        showToast("تعذر النسخ — حاول استخدام زر التحميل بدلاً من ذلك");
      }
    });
    
    setExportEnabled(false);
    
    // ---- report height to parent window, if embedded in an iframe ----
    // (harmless no-op when opened as a standalone page/file)
    function reportHeight(){
      try{
        if (window.parent && window.parent !== window){
          window.parent.postMessage({ type: 'qrToolHeight', height: document.documentElement.scrollHeight }, '*');
        }
      }catch(e){ /* cross-origin or no parent — ignore */ }
    }
    window.addEventListener('load', reportHeight);
    window.addEventListener('resize', reportHeight);
    new MutationObserver(reportHeight).observe(document.body, { childList:true, subtree:true, attributes:true });
    })();
  </script>
</Layout>