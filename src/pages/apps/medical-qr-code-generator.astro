    }
    
    function blockify(dataCodewords, version, level){
      const t = TABLE[version][level];
      const ecPerBlock = t[1], groups = t[2];
      const blocks=[]; let idx=0;
      for (const g of groups){
        const count=g[0], len=g[1];
        for (let i=0;i<count;i++){
