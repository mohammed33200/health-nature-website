    tagAr: "مؤقت",
    tagEn: "Timer",
  },
  {
    href: "/optics/night-glare-test",
    titleAr: "اختبار الوهج والرؤية الليلية",
    titleEn: "Night Glare & Driving Vision Test",
    descAr: "محاكاة أضواء السيارات المقابلة لتقييم صعوبة الرؤية ليلاً.",
    descEn: "Simulates oncoming headlights to assess night-driving vision difficulty.",
