    titleAr: "اختبار عجلة الاستجماتيزم",
    titleEn: "Astigmatism Wheel Test",
    descAr: "رسم شعاعي يكشف تفاوت وضوح الخطوط الدال على اللابؤرية.",
    descEn: "A radial dial that reveals uneven line clarity indicating astigmatism.",
    tagAr: "فحص سريع",
    tagEn: "Quick check",
  },
  {
    href: "/optics/contrast-sensitivity",
    titleAr: "اختبار حساسية التباين",
    titleEn: "Contrast Sensitivity Test",
    descAr: "قياس قدرة العين على تمييز الأشكال الباهتة، مفيد لسائقي الليل.",
