---
// حاسبة السعرات حسب نوع التمرين — METs Calorie Calculator
import Layout from '../../layouts/Layout.astro';
import ToolsShell from '../../layouts/ToolsShell.astro';
---

<Layout title="حاسبة السعرات حسب نوع التمرين">
  <ToolsShell>
    <section class="tool-page">
      <header class="tool-hero">
        <h1>
          <span data-ar>حاسبة السعرات حسب نوع التمرين (METs)</span>
          <span data-en>METs Calorie Calculator</span>
        </h1>
      </header>

      <article class="info-block">
        <h2><span data-ar>ما هي؟</span><span data-en>What is it?</span></h2>
        <p>
          <span data-ar>تحسب السعرات المحروقة في نشاط رياضي معيّن اعتمادًا على "المجهود المكافئ" (MET) الخاص بذلك النشاط، ووزن الشخص، ومدة الممارسة.</span>
          <span data-en>Calculates calories burned in a specific activity based on that activity's Metabolic Equivalent of Task (MET), the person's weight, and the duration.</span>
        </p>
      </article>

      <article class="info-block">
        <h2><span data-ar>لماذا تهم؟</span><span data-en>Why it matters</span></h2>
        <p>
          <span data-ar>MET مقياس معياري يسمح بمقارنة عادلة بين أنواع تمارين مختلفة تمامًا (سباحة مقابل رفع أثقال مقابل قفز حبل)، بدل الاعتماد على تقديرات تقريبية غير موحدة.</span>
          <span data-en>MET is a standardized measure that allows fair comparison between completely different activity types (swimming vs. weightlifting vs. jump rope), instead of relying on inconsistent rough estimates.</span>
        </p>
      </article>

      <form class="calc-form" id="mets-form">
        <label>
          <span data-ar>النشاط</span><span data-en>Activity</span>
          <select id="activity">
            <option value="3.5">مشي معتدل / Moderate walking (3.5 MET)</option>
            <option value="8.3">جري 8 كم/س / Running 8km/h (8.3 MET)</option>
            <option value="6.8">دراجة معتدلة / Moderate cycling (6.8 MET)</option>
            <option value="6">سباحة عامة / General swimming (6 MET)</option>
            <option value="11">قفز الحبل / Jump rope (11 MET)</option>
            <option value="5">رفع أثقال معتدل / Moderate weightlifting (5 MET)</option>
            <option value="7">كرة قدم / Soccer (7 MET)</option>
            <option value="8">كمال أجسام مكثف / Vigorous bodybuilding (8 MET)</option>
          </select>
        </label>
        <label>
          <span data-ar>الوزن (كجم)</span><span data-en>Weight (kg)</span>
          <input type="number" id="weight" min="30" max="200" step="0.1" required />
        </label>
        <label>
          <span data-ar>مدة التمرين (دقائق)</span><span data-en>Duration (minutes)</span>
          <input type="number" id="duration" min="1" max="300" required />
        </label>
        <button type="submit">
          <span data-ar>احسب</span><span data-en>Calculate</span>
        </button>
      </form>

      <div class="result-box" id="result" hidden>
        <p class="result-line">
          <span data-ar>السعرات المحروقة: </span><span data-en>Calories burned: </span>
          <strong id="calories-out"></strong> kcal
        </p>
      </div>

      <article class="info-block">
        <h2><span data-ar>المعادلة</span><span data-en>Formula</span></h2>
        <p class="formula">Calories/min = MET × 3.5 × Weight (kg) / 200</p>
      </article>

      <a class="back-link" href="/fittness/">
        <span data-ar">← رجوع لمجال اللياقة المتقدمة</span>
        <span data-en>← Back to Advanced Fitness</span>
      </a>
    </section>
  </ToolsShell>
</Layout>

<script>
  const form = document.getElementById("mets-form") as HTMLFormElement;
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const met = Number((document.getElementById("activity") as HTMLSelectElement).value);
    const weight = Number((document.getElementById("weight") as HTMLInputElement).value);
    const duration = Number((document.getElementById("duration") as HTMLInputElement).value);
    if (!weight || !duration) return;

    const caloriesPerMin = (met * 3.5 * weight) / 200;
    const total = caloriesPerMin * duration;

    (document.getElementById("calories-out") as HTMLElement).textContent = total.toFixed(0);
    (document.getElementById("result") as HTMLElement).hidden = false;
  });
</script>

<style>
  .tool-page { padding-block: 2rem; max-width: 42rem; margin-inline: auto; }
  .tool-hero h1 { display: flex; flex-direction: column; gap: .15rem; margin-bottom: 1.5rem; }
  .tool-hero [data-en] { font-size: .65em; opacity: .6; font-weight: 500; }
  .info-block { margin-bottom: 1.5rem; }
  .info-block h2 { display: flex; gap: .5rem; font-size: 1rem; margin-bottom: .4rem; }
  .info-block h2 [data-en] { opacity: .6; font-weight: 500; }
  .info-block [data-en] { display: block; font-size: .9em; opacity: .7; margin-top: .3rem; }
  .formula { font-family: monospace; background: rgba(0,0,0,.04); padding: .6rem .8rem; border-radius: .4rem; font-size: .85rem; }

  .calc-form { display: grid; gap: 1rem; margin: 1.5rem 0; padding: 1.25rem; border: 1px solid rgba(0,0,0,.12); border-radius: .75rem; }
  .calc-form label { display: grid; gap: .3rem; font-size: .9rem; }
  .calc-form input, .calc-form select { padding: .5rem .6rem; border: 1px solid rgba(0,0,0,.2); border-radius: .4rem; font-size: 1rem; }
  .calc-form button { justify-self: start; padding: .6rem 1.5rem; border: none; border-radius: .5rem; background: #1d6f5c; color: #fff; font-weight: 600; cursor: pointer; }
  .calc-form button [data-en] { display: block; font-size: .75em; opacity: .85; }

  .result-box { padding: 1.25rem; border-radius: .75rem; background: rgba(29,111,92,.08); margin-bottom: 1.5rem; }
  .result-line { margin: .3rem 0; }
  .result-line [data-en] { opacity: .7; }

  .back-link { display: inline-block; font-size: .85rem; text-decoration: none; }
</style>
