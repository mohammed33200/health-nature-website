---
import Layout from '../../layouts/Layout.astro'; // points to YOUR site's own layout
import ToolsShell from '../../layouts/ToolsShell.astro';
import TestsNav from '../../components/TestsNav.astro';
import MedicalDisclaimer from '../../components/MedicalDisclaimer.astro';

const questions = [
  { id: 'q1', sub: 's', ar: 'وجدت صعوبة في الاسترخاء', en: 'I found it hard to wind down' },
  { id: 'q2', sub: 'a', ar: 'شعرت بجفاف في فمي', en: 'I was aware of dryness of my mouth' },
  { id: 'q3', sub: 'd', ar: 'لم أستطع الشعور بأي مشاعر إيجابية على الإطلاق', en: "I couldn't seem to experience any positive feeling at all" },
  { id: 'q4', sub: 'a', ar: 'واجهت صعوبة في التنفس (كتسارع في التنفس أو ضيق نفس دون بذل مجهود)', en: 'I experienced breathing difficulty (e.g. excessively rapid breathing, breathlessness in the absence of physical exertion)' },
  { id: 'q5', sub: 'd', ar: 'وجدت صعوبة في استجماع المبادرة للقيام بالأشياء', en: 'I found it difficult to work up the initiative to do things' },
  { id: 'q6', sub: 's', ar: 'كنت أميل للمبالغة في ردة فعلي تجاه المواقف', en: 'I tended to over-react to situations' },
  { id: 'q7', sub: 'a', ar: 'شعرت برجفة (مثلاً في اليدين)', en: 'I experienced trembling (e.g. in the hands)' },
  { id: 'q8', sub: 's', ar: 'شعرت أنني أستهلك طاقة عصبية كبيرة', en: 'I felt that I was using a lot of nervous energy' },
  { id: 'q9', sub: 'a', ar: 'كنت قلقاً بشأن مواقف قد أصاب فيها بالذعر وأجعل من نفسي أضحوكة', en: 'I was worried about situations in which I might panic and make a fool of myself' },
  { id: 'q10', sub: 'd', ar: 'شعرت أنه ليس لدي ما أتطلع إليه', en: 'I felt that I had nothing to look forward to' },
  { id: 'q11', sub: 's', ar: 'شعرت بالتوتر والانفعال', en: 'I found myself getting agitated' },
  { id: 'q12', sub: 's', ar: 'وجدت صعوبة في الاسترخاء (بمعنى آخر)', en: 'I found it difficult to relax' },
  { id: 'q13', sub: 'd', ar: 'شعرت بالحزن والكآبة', en: 'I felt down-hearted and blue' },
  { id: 'q14', sub: 's', ar: 'لم أتحمل أي شيء يعيقني عن إنجاز ما كنت أفعله', en: 'I was intolerant of anything that kept me from getting on with what I was doing' },
  { id: 'q15', sub: 'a', ar: 'شعرت بأنني على وشك الإصابة بنوبة ذعر', en: 'I felt I was close to panic' },
  { id: 'q16', sub: 'd', ar: 'لم أستطع أن أتحمس لأي شيء', en: 'I was unable to become enthusiastic about anything' },
  { id: 'q17', sub: 'd', ar: 'شعرت أنني لا أساوي الكثير كإنسان', en: "I felt I wasn't worth much as a person" },
  { id: 'q18', sub: 's', ar: 'شعرت أنني حساس بشكل زائد وسريع التأثر', en: 'I felt that I was rather touchy' },
  { id: 'q19', sub: 'a', ar: 'شعرت بنبضات قلبي واضحة دون بذل مجهود بدني (كتسارع ضربات القلب أو تخطيه)', en: 'I was aware of the action of my heart in the absence of physical exertion (e.g. sense of heart rate increase, heart missing a beat)' },
  { id: 'q20', sub: 'a', ar: 'شعرت بالخوف دون سبب واضح', en: 'I felt scared without any good reason' },
  { id: 'q21', sub: 'd', ar: 'شعرت أن الحياة بلا معنى', en: 'I felt that life was meaningless' },
];

const options = [
  { value: 0, ar: 'لم تنطبق عليّ إطلاقاً', en: 'Did not apply to me at all' },
  { value: 1, ar: 'انطبقت عليّ إلى حد ما، أو بعض الوقت', en: 'Applied to me to some degree, or some of the time' },
  { value: 2, ar: 'انطبقت عليّ إلى حد كبير، أو جزءاً كبيراً من الوقت', en: 'Applied to me to a considerable degree, or a good part of time' },
  { value: 3, ar: 'انطبقت عليّ كثيراً، أو معظم الوقت', en: 'Applied to me very much, or most of the time' },
];

const bandTables = {
  d: [
    { min: 0, max: 9, ar: 'طبيعي', en: 'Normal', color: 'var(--ok)' },
    { min: 10, max: 13, ar: 'خفيف', en: 'Mild', color: 'var(--secondary)' },
    { min: 14, max: 20, ar: 'متوسط', en: 'Moderate', color: 'var(--accent)' },
    { min: 21, max: 27, ar: 'شديد', en: 'Severe', color: 'var(--accent-dark)' },
    { min: 28, max: 42, ar: 'شديد جداً', en: 'Extremely severe', color: 'var(--danger)' },
  ],
  a: [
    { min: 0, max: 7, ar: 'طبيعي', en: 'Normal', color: 'var(--ok)' },
    { min: 8, max: 9, ar: 'خفيف', en: 'Mild', color: 'var(--secondary)' },
    { min: 10, max: 14, ar: 'متوسط', en: 'Moderate', color: 'var(--accent)' },
    { min: 15, max: 19, ar: 'شديد', en: 'Severe', color: 'var(--accent-dark)' },
    { min: 20, max: 42, ar: 'شديد جداً', en: 'Extremely severe', color: 'var(--danger)' },
  ],
  s: [
    { min: 0, max: 14, ar: 'طبيعي', en: 'Normal', color: 'var(--ok)' },
    { min: 15, max: 18, ar: 'خفيف', en: 'Mild', color: 'var(--secondary)' },
    { min: 19, max: 25, ar: 'متوسط', en: 'Moderate', color: 'var(--accent)' },
    { min: 26, max: 33, ar: 'شديد', en: 'Severe', color: 'var(--accent-dark)' },
    { min: 34, max: 42, ar: 'شديد جداً', en: 'Extremely severe', color: 'var(--danger)' },
  ],
};
---
<Layout title="اختبار DASS-21 للاكتئاب والقلق والتوتر">
  <ToolsShell>
  <section class="container tool-hero">
    <p class="kicker" data-ar>الاختبار 09</p>
    <p class="kicker" data-en hidden>Test 09</p>
    <h1 data-ar>الاكتئاب والقلق<br />والتوتر معاً</h1>
    <h1 data-en hidden>Depression, Anxiety<br />&amp; Stress</h1>
    <p class="lead" data-ar>
      واحد وعشرون عبارة عن أسبوعك الماضي، تُقسَّم إلى ثلاث درجات منفصلة —
      لأن هذه المشاعر الثلاثة قد تتداخل لكنها ليست الشيء نفسه.
    </p>
    <p class="lead" data-en hidden>
      Twenty-one statements about your past week, split into three
      separate scores — because these three experiences can overlap but
      aren't the same thing.
    </p>
  </section>

  <MedicalDisclaimer />
  <TestsNav current="dass21" />

  <section class="container info-section">
    <h2 data-ar>مصدر الاختبار</h2>
    <h2 data-en hidden>Test source</h2>
    <p data-ar>
      اختبار <strong>Depression Anxiety Stress Scales-21
      (DASS-21)</strong>، من تطوير Peter F. Lovibond وSyd H. Lovibond،
      جامعة نيو ساوث ويلز، أستراليا، نُشر عام 1995، وهو النسخة المختصرة
      من DASS-42. الاختبار في الملكية العامة رسمياً، بشرط واحد فقط: ألا
      يُباع المقياس نفسه.
    </p>
    <p data-en hidden>
      The <strong>Depression Anxiety Stress Scales-21 (DASS-21)</strong>,
      developed by Peter F. Lovibond and Syd H. Lovibond at the
      University of New South Wales, Australia, published in 1995 — the
      short form of the DASS-42. The instrument is officially in the
      public domain, with just one condition: the scale itself may not
      be sold.
    </p>
  </section>

  <section class="container calc-card">
    <p style="color:var(--ink-soft); font-size:0.85rem; margin-bottom:1rem;" data-ar>
      اقرأ كل عبارة وحدد مدى انطباقها عليك خلال الأسبوع الماضي.
    </p>
    <p style="color:var(--ink-soft); font-size:0.85rem; margin-bottom:1rem;" data-en hidden>
      Read each statement and select how much it applied to you over the
      past week.
    </p>

    <form id="dassForm">
      {questions.map((q, i) => (
        <fieldset class="quiz-item">
          <legend>
            <span class="quiz-num">{i + 1}</span>
            <span data-ar>{q.ar}</span>
            <span data-en hidden>{q.en}</span>
          </legend>
          <div class="quiz-options">
            {options.map((opt) => (
              <label class="quiz-option">
                <input type="radio" name={`q_${q.id}`} value={opt.value} data-sub={q.sub} required />
                <span data-ar>{opt.ar}</span>
                <span data-en hidden>{opt.en}</span>
              </label>
            ))}
          </div>
        </fieldset>
      ))}
      <button class="btn-calc" type="submit">
        <span data-ar>احسب النتيجة</span>
        <span data-en hidden>Calculate Score</span>
      </button>
    </form>

    <div class="result" id="dassResult">
      <p>
        <span data-ar>الاكتئاب:</span> <span data-en hidden>Depression:</span>
        <span class="reading" id="dScore">—</span>
        <span class="badge" id="dBadge"></span>
      </p>
      <p>
        <span data-ar>القلق:</span> <span data-en hidden>Anxiety:</span>
        <span class="reading" id="aScore">—</span>
        <span class="badge" id="aBadge"></span>
      </p>
      <p>
        <span data-ar>التوتر:</span> <span data-en hidden>Stress:</span>
        <span class="reading" id="sScore">—</span>
        <span class="badge" id="sBadge"></span>
      </p>
    </div>
  </section>

  <script define:vars={{
    subOf: Object.fromEntries(questions.map((q) => [q.id, q.sub])),
    ids: questions.map((q) => q.id),
    bandsD: bandTables.d,
    bandsA: bandTables.a,
    bandsS: bandTables.s,
  }}>
    const form = document.getElementById('dassForm');
    const resultEl = document.getElementById('dassResult');
    const els = {
      d: { score: document.getElementById('dScore'), badge: document.getElementById('dBadge'), bands: bandsD },
      a: { score: document.getElementById('aScore'), badge: document.getElementById('aBadge'), bands: bandsA },
      s: { score: document.getElementById('sScore'), badge: document.getElementById('sBadge'), bands: bandsS },
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const totals = { d: 0, a: 0, s: 0 };

      for (const id of ids) {
        const selected = form.querySelector(`input[name="q_${id}"]:checked`);
        if (!selected) return;
        const sub = subOf[id];
        totals[sub] += parseFloat(selected.value);
      }

      const lang = resultEl.closest('.tools-scope')?.getAttribute('data-lang') || 'ar';

      for (const key of ['d', 'a', 's']) {
        const doubled = totals[key] * 2;
        const band = els[key].bands.find((b) => doubled >= b.min && doubled <= b.max) || els[key].bands[els[key].bands.length - 1];
        els[key].score.textContent = doubled.toString();
        els[key].badge.textContent = lang === 'ar' ? band.ar : band.en;
        els[key].badge.style.background = band.color;
      }

      resultEl.classList.add('show');
      resultEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
  </script>

  <section class="container info-section">
    <h2 data-ar>ما الهدف من هذا الاختبار؟</h2>
    <h2 data-en hidden>What is this test for?</h2>
    <p data-ar>
      يفصل ثلاث حالات شعورية غالباً ما تختلط: الاكتئاب (فقدان الأمل
      والمتعة)، والقلق (الإثارة الجسدية والخوف)، والتوتر (صعوبة الاسترخاء
      وسرعة الانفعال). كل بُعد له سبع عبارات ودرجته الخاصة، فقد تكون
      قلقك مرتفعاً واكتئابك طبيعياً، أو العكس.
    </p>
    <p data-en hidden>
      It separates three emotional states that often get blurred
      together: depression (loss of hope and pleasure), anxiety
      (physical arousal and fear), and stress (difficulty relaxing and
      quick irritability). Each dimension has seven statements and its
      own score — your anxiety might be elevated while your depression
      score is normal, or vice versa.
    </p>

    <h2 data-ar>كيف تستفيد من نتيجتك؟</h2>
    <h2 data-en hidden>How do you benefit from your result?</h2>
    <p data-ar>
      انظر للأبعاد الثلاثة معاً لا لواحد فقط — فمعرفة أيها الأعلى تساعدك
      ومختصك على توجيه المحادثة الأولى بدقة أكبر. أعد الاختبار كل
      أسبوعين إن كنت تحت متابعة، فانخفاض بُعد واحد فقط مع بقاء الآخرين
      مرتفعين معلومة قيّمة بحد ذاتها.
    </p>
    <p data-en hidden>
      Look at all three dimensions together, not just one — knowing
      which is highest helps you and a professional focus the first
      conversation more precisely. Retake it every two weeks if you're
      under care; one dimension dropping while the others stay elevated
      is valuable information on its own.
    </p>
  </section>
</ToolsShell>
</Layout>