---
import Layout from '../../layouts/Layout.astro';
import ToolsShell from '../../layouts/ToolsShell.astro';
---

<Layout title="تعديل مواعيد الأدوية أثناء الصيام المتقطع" description="عادي (يُسمح بالماء) أو جاف — بدون قاعدة بيانات دوائية">
  <ToolsShell>
    <div class="tool-hero">
      <a href="/fast/" class="back-link">
        <span data-ar>‹ العودة إلى أدوات الصيام</span>
        <span data-en>‹ Back to Fasting Tools</span>
      </a>
      <div class="page-actions">
        <button onclick="window.print()" class="action-btn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 6 2 18 2 18 9"></polyline>
            <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
            <rect x="6" y="14" width="12" height="8"></rect>
          </svg>
          <span data-ar>طباعة</span><span data-en>Print</span>
        </button>
        <a href="?embed=true" class="action-btn" target="_blank">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 3h6v6"></path>
            <path d="M10 14 21 3"></path>
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
          </svg>
          <span data-ar>تضمين</span><span data-en>Embed</span>
        </a>
      </div>
      <p class="kicker"><span data-ar>أدوات الصيام</span><span data-en>Fasting Tools</span></p>
      <h1>
        <span data-ar>تعديل مواعيد الأدوية أثناء الصيام المتقطع</span>
        <span data-en>Intermittent Fasting Medication Adjuster</span>
      </h1>
      <p class="lead"><span data-ar>عادي (يُسمح بالماء) أو جاف — بدون قاعدة بيانات دوائية</span><span data-en>Regular (water allowed) or dry — no drug database</span></p>
    </div>

  <script is:inline type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "هل يجوز أخذ الدواء أثناء الصيام المتقطع؟",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "في الصيام العادي (يُسمح بالماء)، يمكن غالباً أخذ الدواء الفموي مع الماء دون كسر الصيام حسب رأي أغلب الأطباء؛ أما في الصيام الجاف فلا يجوز أخذ أي شيء فموياً حتى الماء."
        }
      },
      {
        "@type": "Question",
        "name": "كم أقصى مدة آمنة للصيام الجاف؟",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "يُنصح بعدم تجاوز 24 ساعة، ويُعتبر تجاوز 36 ساعة عامل خطر صحي مرتفع يستدعي التوقف الفوري واستشارة الطبيب."
        }
      },
      {
        "@type": "Question",
        "name": "ماذا لو تعارضت مواعيد دوائين مع بعضهما بعد التعديل؟",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "الأداة تنبهك تلقائياً بأي تعارض في الفصل الذي أدخلته بنفسك بين دواءين، لتراجعه مع طبيبك أو صيدليك قبل الالتزام بالجدول."
        }
      }
    ]
  }
  </script>

  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
  <style>
  :root{
    --warn:#c98a2c;
    --radius:14px;
    --shadow:0 4px 14px rgba(30,58,63,0.08);
  }
  .fast-nav{ display:flex; gap:8px; overflow-x:auto; padding:10px 14px; background:var(--paper-alt); border-bottom:1px solid var(--line); position:sticky; top:0; z-index:40; -webkit-overflow-scrolling:touch; }
    .fast-nav a{ flex:0 0 auto; padding:8px 14px; border-radius:20px; background:var(--paper); color:var(--ink-soft); text-decoration:none; font-size:.82rem; border:1px solid var(--line); white-space:nowrap; }
    .fast-nav a.active{ background:var(--accent); color:#fff; border-color:var(--accent); font-weight:bold; }
    .page-actions{ display:flex; gap:10px; margin-bottom:16px; }
    .action-btn{ display:inline-flex; align-items:center; gap:8px; padding:8px 16px; background:var(--paper); border:1px solid var(--line); border-radius:8px; color:var(--ink); text-decoration:none; font-size:.85rem; cursor:pointer; transition:background .15s; }
    .action-btn:hover{ background:var(--paper-alt); }
    .action-btn svg{ width:18px; height:18px; }
    .back-link{ display:inline-block; margin-bottom:8px; color:var(--secondary-dark); text-decoration:none; font-size:.85rem; }
    .back-link:hover{ text-decoration:underline; }
    .kicker{ font-family:"IBM Plex Mono",monospace; font-size:.8rem; color:var(--secondary-dark); letter-spacing:.06em; margin-bottom:8px; }
    .container{ max-width:760px; margin:14px auto 0; padding:0 14px; }
    .calc-card{ background:var(--paper-alt); border:1px solid var(--line); border-radius:var(--radius); box-shadow:var(--shadow); padding:18px 18px 20px; margin-bottom:18px; }
    .calc-card h2{ margin:0 0 4px; font-size:1.05rem; color:var(--accent-dark); display:flex; align-items:center; gap:8px; }
    .calc-card .sub{ margin:0 0 14px; color:var(--ink-soft); font-size:.85rem; }
    .row{ display:flex; gap:10px; flex-wrap:wrap; margin-bottom:10px; }
    .field{ flex:1 1 150px; display:flex; flex-direction:column; gap:5px; }
    .field label{ font-size:.82rem; color:var(--ink-soft); }
    .field select, .field input{ padding:9px 10px; border:1px solid var(--line); border-radius:8px; font-size:.95rem; background:#fff; color:var(--ink); font-family:inherit; }
    .meal-row{ display:flex; align-items:center; gap:8px; margin-bottom:8px; }
    .meal-row label{ flex:0 0 150px; font-size:.85rem; color:var(--ink-soft); display:flex; align-items:center; gap:6px; }
    .meal-row input[type=time]{ flex:1; padding:8px; border:1px solid var(--line); border-radius:7px; font-family:inherit; }

    .type-tabs{ display:flex; gap:8px; margin-bottom:6px; }
    .type-tabs button{ flex:1; padding:9px; border-radius:8px; border:1px solid var(--line); background:var(--paper); color:var(--ink-soft); cursor:pointer; font-size:.85rem; font-family:inherit; }
    .type-tabs button.active{ background:var(--accent); color:#fff; border-color:var(--accent); }
    .type-note{ font-size:.78rem; color:var(--ink-soft); margin:0 0 14px; }

    .med-card{ border:1px solid var(--line); border-radius:12px; padding:14px; margin-bottom:12px; background:var(--paper); position:relative; }
    .med-card .med-remove{ position:absolute; top:10px; inset-inline-end:10px; background:none; border:none; color:var(--danger); font-size:1.1rem; cursor:pointer; }
    .med-card h3{ margin:0 0 10px; font-size:.95rem; color:var(--accent-dark); }

    .sep-item{ display:flex; align-items:center; gap:6px; background:#fff; border:1px solid var(--line); border-radius:7px; padding:6px 8px; margin-bottom:6px; font-size:.8rem; }
    .sep-item select, .sep-item input{ padding:5px 6px; border:1px solid var(--line); border-radius:5px; font-size:.8rem; font-family:inherit; }
    .sep-item .remove-sep{ background:none; border:none; color:var(--danger); cursor:pointer; margin-inline-start:auto; }
    .add-sep-btn{ font-size:.78rem; padding:6px 10px; border:1px dashed var(--secondary); background:#fff; border-radius:7px; color:var(--accent-dark); cursor:pointer; }

    .add-row-btn{ width:100%; padding:10px; border:1px dashed var(--secondary); border-radius:9px; background:#fff; color:var(--accent-dark); cursor:pointer; font-size:.9rem; margin:6px 0 4px; }
    .add-row-btn:hover{ background:var(--paper); }
    .btn-calc{ width:100%; padding:11px; border:none; border-radius:9px; background:var(--accent); color:#fff; font-size:.95rem; cursor:pointer; margin-top:10px; }
    .btn-calc:hover{ background:var(--accent-dark); }

    .faith-banner{ background:#eef7f2; border:1px solid var(--ok); border-radius:10px; padding:12px 16px; font-size:.85rem; color:var(--ink); margin-bottom:18px; }

    .result{ display:none; margin-top:6px; }
    .result.show{ display:block; }
    .dose-item{ display:flex; gap:12px; align-items:center; background:var(--paper); border:1px solid var(--line); border-radius:10px; padding:10px 12px; margin-bottom:8px; }
    .dose-time{ font-family:"Courier New",monospace; font-weight:bold; color:var(--accent-dark); font-size:1.1rem; min-width:60px; text-align:center; }
    .dose-body{ flex:1; }
    .dose-name{ font-weight:bold; font-size:.95rem; }
    .dose-note{ font-size:.78rem; color:var(--ink-soft); }
    .dose-warn{ font-size:.78rem; color:var(--warn); margin-top:2px; }
    .dose-moved{ font-size:.78rem; color:var(--accent-dark); margin-top:2px; }
    .dose-conflict{ font-size:.78rem; color:var(--danger); margin-top:2px; }
    .advisory-box{ background:#fff8ea; border:1px solid var(--warn); border-radius:10px; padding:10px 12px; margin-bottom:8px; }
    .advisory-box .dose-name{ color:var(--warn); }

    .tips-box{ background:#fff8ea; border:1px solid var(--warn); border-radius:10px; padding:12px 16px; font-size:.85rem; margin-bottom:14px; }

    .global-actions{ display:flex; gap:8px; margin-top:14px; flex-wrap:wrap; }
    .global-actions button, .global-actions a{ flex:1 1 auto; text-align:center; padding:10px 10px; border-radius:8px; border:1px solid var(--line); background:#fff; color:var(--ink); font-size:.85rem; cursor:pointer; text-decoration:none; font-family:inherit; }
    .global-actions button:hover, .global-actions a:hover{ background:var(--paper); }

    .disclaimer{ max-width:760px; margin:10px auto 0; padding:0 14px; font-size:.78rem; color:var(--ink-soft); text-align:center; }
    .toast{ position:fixed; bottom:20px; left:50%; transform:translateX(-50%); background:var(--ink); color:#fff; padding:9px 18px; border-radius:20px; font-size:.85rem; opacity:0; pointer-events:none; transition:opacity .25s; z-index:50; }
    .toast.show{ opacity:1; }

    #print-card{ position:fixed; top:0; left:0; z-index:-999; width:680px; background:#fff; font-family:"Tahoma","Segoe UI",Arial,sans-serif; }
    #print-card .pc-header{ background:linear-gradient(120deg,var(--accent),var(--accent-dark)); color:#fff; padding:22px 26px; text-align:center; }
    #print-card .pc-header h1{ margin:0 0 4px; font-size:1.3rem; }
    #print-card .pc-body{ padding:20px 26px 26px; }
    #print-card .pc-row{ display:flex; align-items:center; gap:14px; border-bottom:1px solid #e4eef0; padding:10px 0; }
    #print-card .pc-time{ font-family:"Courier New",monospace; font-weight:bold; color:var(--accent-dark); font-size:1.1rem; min-width:60px; }
    #print-card .pc-name{ font-weight:bold; }
    #print-card .pc-note{ font-size:.82rem; color:var(--ink-soft); }
    #print-card .pc-footer{ text-align:center; color:#8a7f68; font-size:.78rem; padding:10px 26px 20px; }
  </style>

