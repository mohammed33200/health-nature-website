        <button class="active" data-v="regular" onclick="setFastType('regular')"><span data-ar>عادي (يُسمح بالماء)</span><span data-en>Regular (water allowed)</span></button>
        <button data-v="dry" onclick="setFastType('dry')"><span data-ar>جاف (لا ماء ولا طعام)</span><span data-en>Dry (no water or food)</span></button>
      </div>
      <p class="type-note" id="type-note"></p>

