        <div class="field">
          <label><span data-ar>بداية الصيام</span><span data-en>Fast start</span></label>
          <input type="time" id="f-start" value="20:00">
        </div>
        <div class="field">
          <label><span data-ar>نهاية الصيام (بداية الأكل)</span><span data-en>Fast end (eating begins)</span></label>
          <input type="time" id="f-end" value="12:00">
        </div>
      </div>

      <p class="sub" style="margin:12px 0 6px;"><span data-ar>وجبات نافذة الأكل</span><span data-en>Meals within the eating window</span></p>
      <div class="meal-row">
        <label><input type="checkbox" id="meal-breakfast-en" checked> <span data-ar>وجبة كسر الصيام</span><span data-en>Break-fast meal</span></label>
        <input type="time" id="meal-breakfast-t" value="12:00">
      </div>
      <div class="meal-row">
        <label><input type="checkbox" id="meal-dinner-en" checked> <span data-ar>آخر وجبة قبل الصيام</span><span data-en>Last meal before fasting</span></label>
        <input type="time" id="meal-dinner-t" value="19:30">
