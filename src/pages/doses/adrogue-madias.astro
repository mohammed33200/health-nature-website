---
// حاسبة صوديوم الطوارئ ومعدل التقطير — Adrogué-Madias Formula
import Layout from '../../layouts/Layout.astro';
import ToolsShell from '../../layouts/ToolsShell.astro';
---

<Layout title="حاسبة صوديوم الطوارئ ومعدل التقطير">
  <ToolsShell>
    <section class="tool-page">
      <header class="tool-hero">
        <h1>
          <span data-ar>حاسبة صوديوم الطوارئ ومعدل التقطير</span>
          <span data-en>Adrogué-Madias Formula</span>
        </h1>
        <span class="badge badge-dosing"><span data-ar>جرعات دوائية</span><span data-en>Dosing</span></span>
        <p class="credit-line">Adrogué &amp; Madias, 2000</p>
      </header>

      <article class="info-block">
        <h2><span data-ar>ما هي؟</span><span data-en>What is it?</span></h2>
        <p>
          <span data-ar>تقدّر مقدار تغيّر صوديوم الدم المتوقع عند إعطاء لتر واحد من محلول وريدي معيّن، بناءً على وزن المريض والصوديوم الحالي ونوع المحلول.</span>
          <span data-en>Estimates the expected change in serum sodium from infusing one liter of a specific IV fluid, based on patient weight, current sodium, and fluid type.</span>
        </p>
      </article>

      <article class="info-block">
        <h2><span data-ar>لماذا تهم؟</span><span data-en>Why it matters</span></h2>
        <p>
          <span data-ar>تصحيح الصوديوم بسرعة زائدة (خصوصًا في نقص الصوديوم المزمن) قد يسبب متلازمة إزالة الميالين الجسري، أما التصحيح البطيء جدًا فقد لا يعالج الأعراض الخطيرة في الوقت المناسب — هذه المعادلة تساعد على اختيار المحلول والمعدل المناسبين لتصحيح آمن ومتدرّج.</span>
          <span data-en>Correcting sodium too fast (especially in chronic hyponatremia) can cause osmotic demyelination syndrome, while correcting too slowly may fail to treat dangerous symptoms in time — this formula helps choose the right fluid and rate for a safe, gradual correction.</span>
        </p>
      </article>

      <form class="calc-form" id="am-form">
        <label>
          <span data-ar>الوزن (كجم)</span><span data-en>Weight (kg)</span>
          <input type="number" id="weight" min="20" max="200" step="0.1" required />
        </label>
        <label>
          <span data-ar>الجنس</span><span data-en>Sex</span>
          <select id="sex">
            <option value="male">ذكر / Male (TBW×0.6)</option>
            <option value="female">أنثى / Female (TBW×0.5)</option>
          </select>
        </label>
        <label>
          <span data-ar>صوديوم الدم الحالي (ملي مكافئ/لتر)</span><span data-en>Current serum sodium (mEq/L)</span>
          <input type="number" id="serumNa" min="100" max="170" required />
        </label>
        <label>
          <span data-ar>نوع المحلول الوريدي</span><span data-en>IV fluid type</span>
          <select id="fluid">
            <option value="513">محلول ملحي 3% / 3% NaCl (513 mEq/L)</option>
            <option value="154">محلول ملحي 0.9% / 0.9% NS (154 mEq/L)</option>
            <option value="130">رينجر لاكتات / Lactated Ringer's (130 mEq/L)</option>
            <option value="77">محلول ملحي 0.45% / 0.45% NS (77 mEq/L)</option>
          </select>
        </label>
        <button type="submit">
          <span data-ar>احسب</span><span data-en>Calculate</span>
        </button>
      </form>

      <div class="result-box" id="result" hidden>
        <p class="result-line">
          <span data-ar>التغير المتوقع لكل لتر: </span><span data-en>Expected change per liter: </span>
          <strong id="delta-out"></strong> mEq/L
        </p>
      </div>

      <article class="info-block">
        <h2><span data-ar>القياس الطبيعي / المعادلة</span><span data-en>Formula &amp; reference</span></h2>
        <p class="formula">ΔNa = (Infusate Na − Serum Na) / (TBW + 1)</p>
        <ul class="ref-list">
          <li><span data-ar>الحد الأقصى الآمن للتصحيح: 8–10 ملي مكافئ/لتر خلال 24 ساعة (أقل في المرضى عاليي الخطورة)</span><span data-en>Maximum safe correction: 8–10 mEq/L over 24h (lower in high-risk patients)</span></li>
        </ul>
      </article>

      <p class="disclaimer">
        <span data-ar>هذه المعادلة تقديرية وتفترض توزيعًا مثاليًا للماء؛ يجب مراقبة الصوديوم الفعلي كل 2–4 ساعات وتعديل الخطة وفق الاستجابة الحقيقية.</span>
        <span data-en>This formula is an estimate assuming ideal water distribution; actual sodium must be monitored every 2–4 hours and the plan adjusted to the real response.</span>
      </p>

      <a class="back-link" href="/doses/">
        <span data-ar="← رجوع لمجال جرعات الأدوية">← رجوع لمجال جرعات الأدوية</span>
        <span data-en>← Back to Medication Dosing</span>
      </a>
    </section>
  </ToolsShell>
</Layout>

<script>
  const form = document.getElementById("am-form") as HTMLFormElement;
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const weight = Number((document.getElementById("weight") as HTMLInputElement).value);
    const sex = (document.getElementById("sex") as HTMLSelectElement).value;
    const serumNa = Number((document.getElementById("serumNa") as HTMLInputElement).value);
    const fluidNa = Number((document.getElementById("fluid") as HTMLSelectElement).value);
    if (!weight || !serumNa) return;

    const factor = sex === "male" ? 0.6 : 0.5;
    const tbw = weight * factor;
    const delta = (fluidNa - serumNa) / (tbw + 1);

    (document.getElementById("delta-out") as HTMLElement).textContent = delta.toFixed(2);
    (document.getElementById("result") as HTMLElement).hidden = false;
  });
</script>

<style>
  .tool-page { padding-block: 2rem; max-width: 42rem; margin-inline: auto; }
  .tool-hero { display: flex; align-items: center; gap: .75rem; flex-wrap: wrap; margin-bottom: .3rem; }
  .tool-hero h1 { display: flex; flex-direction: column; gap: .15rem; }
  .tool-hero .lang-en { font-size: .65em; opacity: .6; font-weight: 500; }
  .badge-dosing { font-size: .7rem; padding: .2rem .6rem; border-radius: 999px; background: rgba(180,90,0,.12); }
  .credit-line { font-size: .75rem; opacity: .5; font-style: italic; margin-bottom: 1.2rem; width: 100%; }
  .info-block { margin-bottom: 1.5rem; }
  .info-block h2 { display: flex; gap: .5rem; font-size: 1rem; margin-bottom: .4rem; }
  .info-block h2 .lang-en { opacity: .6; font-weight: 500; }
  .info-block .lang-en { display: block; font-size: .9em; opacity: .7; margin-top: .3rem; }
  .formula { font-family: monospace; background: rgba(0,0,0,.04); padding: .6rem .8rem; border-radius: .4rem; font-size: .85rem; margin-bottom: .75rem; }
  .ref-list { list-style: none; padding: 0; display: grid; gap: .4rem; }
  .ref-list li { padding: .5rem .75rem; background: rgba(0,0,0,.04); border-radius: .4rem; }
  .ref-list .lang-en { display: block; font-size: .85em; opacity: .65; }

  .calc-form { display: grid; gap: 1rem; margin: 1.5rem 0; padding: 1.25rem; border: 1px solid rgba(0,0,0,.12); border-radius: .75rem; }
  .calc-form label { display: grid; gap: .3rem; font-size: .9rem; }
  .calc-form input, .calc-form select { padding: .5rem .6rem; border: 1px solid rgba(0,0,0,.2); border-radius: .4rem; font-size: 1rem; }
  .calc-form button { justify-self: start; padding: .6rem 1.5rem; border: none; border-radius: .5rem; background: #1d6f5c; color: #fff; font-weight: 600; cursor: pointer; }
  .calc-form button .lang-en { display: block; font-size: .75em; opacity: .85; }

  .result-box { padding: 1.25rem; border-radius: .75rem; background: rgba(29,111,92,.08); margin-bottom: 1.5rem; }
  .result-line { margin: .3rem 0; }
  .result-line .lang-en { opacity: .7; }

  .disclaimer { margin: 1.5rem 0; padding: 1rem 1.2rem; border-inline-start: 3px solid currentColor; font-size: .85rem; opacity: .85; }
  .disclaimer .lang-en { display: block; margin-top: .4rem; opacity: .8; }

  .back-link { display: inline-block; font-size: .85rem; text-decoration: none; }
</style>
