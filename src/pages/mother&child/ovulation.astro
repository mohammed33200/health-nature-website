---
// حاسبة أيام التبويض ونافذة الخصوبة — Ovulation Calculator
import Layout from '../../layouts/Layout.astro';
import ToolsShell from '../../layouts/ToolsShell.astro';
---
<Layout title="حاسبة أيام التبويض">
  <ToolsShell>
    <section class="tool-page container">
      <header class="tool-hero">
        <h1 data-ar>حاسبة أيام التبويض ونافذة الخصوبة</h1>
        <h1 data-en hidden>Ovulation Calculator</h1>
      </header>

      <article class="info-block">
        <h2 data-ar>ما هي؟</h2><h2 data-en hidden>What is it?</h2>
        <p data-ar>أداة تُقدّر يوم التبويض المتوقع ونافذة الخصوبة (الأيام الأعلى احتمالاً للحمل)، اعتمادًا على تاريخ آخر دورة شهرية ومتوسط طول الدورة.</p>
        <p data-en hidden>Estimates the expected ovulation day and the fertile window (the days with the highest chance of conception), based on the last period date and average cycle length.</p>
      </article>

      <article class="info-block">
        <h2 data-ar>لماذا تهم؟</h2><h2 data-en hidden>Why it matters</h2>
        <p data-ar>تحديد نافذة الخصوبة يساعد الأزواج الراغبين بالحمل على توقيت العلاقة الزوجية بأفضل شكل، كما يفيد من يتابعن انتظام الدورة أو يخططن لتجنب الحمل بطرق طبيعية (يجب استشارة الطبيب لأي قرار تنظيم أسرة).</p>
        <p data-en hidden>Identifying the fertile window helps couples trying to conceive time intercourse effectively, and helps those tracking cycle regularity or using natural family-planning methods (consult a physician for any family-planning decision).</p>
      </article>

      <form class="calc-form" id="ovulation-form">
        <label>
          <span data-ar>تاريخ أول يوم من آخر دورة شهرية</span>
          <span data-en hidden>First day of last period</span>
          <input type="date" id="lmp" required />
        </label>
        <label>
          <span data-ar>متوسط طول الدورة (أيام)</span>
          <span data-en hidden>Average cycle length (days)</span>
          <input type="number" id="cycle" min="20" max="45" value="28" />
        </label>
        <button type="submit" class="btn-calc">
          <span data-ar>احسب</span>
          <span data-en hidden>Calculate</span>
        </button>
      </form>

      <div class="result" id="result">
        <p>
          <span data-ar>يوم التبويض المتوقع: </span><span data-en hidden>Expected ovulation day: </span>
          <strong id="ovu-out" class="reading"></strong>
        </p>
        <p>
          <span data-ar>نافذة الخصوبة: </span><span data-en hidden>Fertile window: </span>
          <strong id="window-out" class="reading"></strong>
        </p>
        <p>
          <span data-ar>الدورة القادمة المتوقعة: </span><span data-en hidden>Next expected period: </span>
          <strong id="next-out" class="reading"></strong>
        </p>
      </div>

      <article class="info-block">
        <h2 data-ar>القياس الطبيعي</h2><h2 data-en hidden>Normal reference</h2>
        <ul class="ref-list">
          <li><span data-ar>التبويض يحدث عادة قبل 14 يومًا من بدء الدورة القادمة (وليس بعد 14 يومًا من بدء الدورة الحالية)</span><span data-en hidden>Ovulation typically occurs 14 days before the next period starts (not 14 days after the current one)</span></li>
          <li><span data-ar>البويضة تعيش 12–24 ساعة، والحيوانات المنوية حتى 5 أيام داخل الجسم</span><span data-en hidden>The egg survives 12–24 hours; sperm can survive up to 5 days in the body</span></li>
          <li><span data-ar>نافذة الخصوبة الفعلية: 5 أيام قبل التبويض ويوم التبويض نفسه</span><span data-en hidden>Effective fertile window: the 5 days before ovulation plus ovulation day itself</span></li>
        </ul>
      </article>

      <a class="back-link" href="/mother&child/">
        <span data-ar>← رجوع لمجال الأمومة والطفولة</span>
        <span data-en hidden>← Back to Maternity &amp; Pediatrics</span>
      </a>
    </section>
  </ToolsShell>
</Layout>

<script>
  const form = document.getElementById("ovulation-form") as HTMLFormElement;
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const lmpVal = (document.getElementById("lmp") as HTMLInputElement).value;
    const cycle = Number((document.getElementById("cycle") as HTMLInputElement).value) || 28;
    if (!lmpVal) return;

    const lmp = new Date(lmpVal);
    const ovulation = new Date(lmp);
    ovulation.setDate(ovulation.getDate() + (cycle - 14));

    const windowStart = new Date(ovulation);
    windowStart.setDate(windowStart.getDate() - 5);

    const nextPeriod = new Date(lmp);
    nextPeriod.setDate(nextPeriod.getDate() + cycle);

    const fmt = (d: Date) => d.toLocaleDateString("ar-EG", { month: "long", day: "numeric" });

    (document.getElementById("ovu-out") as HTMLElement).textContent = fmt(ovulation);
    (document.getElementById("window-out") as HTMLElement).textContent = `${fmt(windowStart)} - ${fmt(ovulation)}`;
    (document.getElementById("next-out") as HTMLElement).textContent = fmt(nextPeriod);

    (document.getElementById("result") as HTMLElement).classList.add('show');
  });
</script>

<style>
  .tool-page { padding-block: 2rem; max-width: 42rem; }
  .info-block { margin-bottom: 1.5rem; max-width: 60ch; }
  .info-block h2 { font-size: 1.1rem; margin-bottom: .4rem; }
  .info-block p { color: var(--ink-soft); }
  .ref-list { list-style: none; padding: 0; display: grid; gap: .4rem; }
  .ref-list li { padding: .5rem .75rem; background: var(--paper-alt); border-radius: .4rem; }
  .calc-form { display: grid; gap: 1rem; margin: 1.5rem 0; padding: 1.25rem; border: 1px solid var(--line); border-radius: .75rem; background: #fff; }
  .calc-form label { display: grid; gap: .3rem; font-size: .9rem; }
  .calc-form input { padding: .5rem .6rem; border: 1px solid var(--line); border-radius: .4rem; font-size: 1rem; }
  .calc-form button { justify-self: start; }
  .back-link { display: inline-block; font-size: .85rem; text-decoration: none; margin-top: 1rem; }
</style>
