  .badges { display: block; margin-top: .5rem; }
  .badge { display: inline-block; font-size: .65rem; margin-inline-end: .3rem; padding: .1rem .5rem; border-radius: 999px; }
  .badge-new { background: rgba(30,110,200,.14); font-weight: 700; }
  .badge-dosing { background: rgba(180,90,0,.12); }
  .badge-credit { background: rgba(0,0,0,.06); font-style: italic; }
  .badge .lang-en { font-size: .9em; opacity: .8; }

  .domain-disclaimer { margin-top: 2rem; padding: 1rem 1.2rem; border-inline-start: 3px solid currentColor; font-size: .85rem; opacity: .85; }
  .domain-disclaimer .lang-en { display: block; margin-top: .4rem; opacity: .8; }
