  .tool-grid { list-style: none; margin: 0 0 2rem; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: .75rem; }
  .tool-card a { display: block; padding: .85rem 1rem; border: 1px solid rgba(0,0,0,.12); border-radius: .6rem; text-decoration: none; height: 100%; }
