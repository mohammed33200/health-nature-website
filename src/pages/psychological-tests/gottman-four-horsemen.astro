import Layout from '../../layouts/Layout.astro';

const CONFIG = {"questions": [{"text": {"ar": "عندما ينزعجني تصرف شريكي، أنتقد شخصيته بدل التصرف نفسه (مثل \"أنت دائمًا كذا\").", "en": "When my partner's behavior upsets me, I criticize their character instead of the behavior itself (like \"you always do this\")."}, "group": "criticism", "options": [{"v": 1, "label": {"ar": "أبدًا", "en": "Never"}}, {"v": 2, "label": {"ar": "نادرًا", "en": "Rarely"}}, {"v": 3, "label": {"ar": "أحيانًا", "en": "Sometimes"}}, {"v": 4, "label": {"ar": "غالبًا", "en": "Often"}}, {"v": 5, "label": {"ar": "دائمًا", "en": "Always"}}]}, {"text": {"ar": "أستخدم عبارات مثل \"أنت أبدًا\" أو \"أنت دائمًا\" عند الانزعاج.", "en": "I use phrases like \"you never\" or \"you always\" when upset."}, "group": "criticism", "options": [{"v": 1, "label": {"ar": "أبدًا", "en": "Never"}}, {"v": 2, "label": {"ar": "نادرًا", "en": "Rarely"}}, {"v": 3, "label": {"ar": "أحيانًا", "en": "Sometimes"}}, {"v": 4, "label": {"ar": "غالبًا", "en": "Often"}}, {"v": 5, "label": {"ar": "دائمًا", "en": "Always"}}]}, {"text": {"ar": "أعمم الانتقاد ليشمل شخصية شريكي كاملة وليس الموقف المحدد فقط.", "en": "I generalize criticism to my partner's whole personality instead of the specific situation."}, "group": "criticism", "options": [{"v": 1, "label": {"ar": "أبدًا", "en": "Never"}}, {"v": 2, "label": {"ar": "نادرًا", "en": "Rarely"}}, {"v": 3, "label": {"ar": "أحيانًا", "en": "Sometimes"}}, {"v": 4, "label": {"ar": "غالبًا", "en": "Often"}}, {"v": 5, "label": {"ar": "دائمًا", "en": "Always"}}]}, {"text": {"ar": "أشعر أنني أهاجم من هو شريكي وليس فقط ما فعله.", "en": "I feel like I'm attacking who my partner is, not just what they did."}, "group": "criticism", "options": [{"v": 1, "label": {"ar": "أبدًا", "en": "Never"}}, {"v": 2, "label": {"ar": "نادرًا", "en": "Rarely"}}, {"v": 3, "label": {"ar": "أحيانًا", "en": "Sometimes"}}, {"v": 4, "label": {"ar": "غالبًا", "en": "Often"}}, {"v": 5, "label": {"ar": "دائمًا", "en": "Always"}}]}, {"text": {"ar": "أستخف بشريكي أو أتحدث بسخرية أو استعلاء أثناء الخلاف.", "en": "I belittle my partner or speak with sarcasm or superiority during a disagreement."}, "group": "contempt", "options": [{"v": 1, "label": {"ar": "أبدًا", "en": "Never"}}, {"v": 2, "label": {"ar": "نادرًا", "en": "Rarely"}}, {"v": 3, "label": {"ar": "أحيانًا", "en": "Sometimes"}}, {"v": 4, "label": {"ar": "غالبًا", "en": "Often"}}, {"v": 5, "label": {"ar": "دائمًا", "en": "Always"}}]}, {"text": {"ar": "أدير عيني أو أُظهر ازدراءً عند حديث شريكي.", "en": "I roll my eyes or show contempt when my partner talks."}, "group": "contempt", "options": [{"v": 1, "label": {"ar": "أبدًا", "en": "Never"}}, {"v": 2, "label": {"ar": "نادرًا", "en": "Rarely"}}, {"v": 3, "label": {"ar": "أحيانًا", "en": "Sometimes"}}, {"v": 4, "label": {"ar": "غالبًا", "en": "Often"}}, {"v": 5, "label": {"ar": "دائمًا", "en": "Always"}}]}, {"text": {"ar": "أقارن شريكي بشكل سلبي بأشخاص آخرين أمامه.", "en": "I negatively compare my partner to other people in front of them."}, "group": "contempt", "options": [{"v": 1, "label": {"ar": "أبدًا", "en": "Never"}}, {"v": 2, "label": {"ar": "نادرًا", "en": "Rarely"}}, {"v": 3, "label": {"ar": "أحيانًا", "en": "Sometimes"}}, {"v": 4, "label": {"ar": "غالبًا", "en": "Often"}}, {"v": 5, "label": {"ar": "دائمًا", "en": "Always"}}]}, {"text": {"ar": "أشعر أحيانًا بتفوق أو احتقار تجاه شريكي في لحظات الخلاف.", "en": "I sometimes feel superior to or contemptuous of my partner during conflict."}, "group": "contempt", "options": [{"v": 1, "label": {"ar": "أبدًا", "en": "Never"}}, {"v": 2, "label": {"ar": "نادرًا", "en": "Rarely"}}, {"v": 3, "label": {"ar": "أحيانًا", "en": "Sometimes"}}, {"v": 4, "label": {"ar": "غالبًا", "en": "Often"}}, {"v": 5, "label": {"ar": "دائمًا", "en": "Always"}}]}, {"text": {"ar": "عندما ينتقدني شريكي، أرد باتهامه بدلاً من الاستماع.", "en": "When my partner criticizes me, I respond by accusing them instead of listening."}, "group": "defensiveness", "options": [{"v": 1, "label": {"ar": "أبدًا", "en": "Never"}}, {"v": 2, "label": {"ar": "نادرًا", "en": "Rarely"}}, {"v": 3, "label": {"ar": "أحيانًا", "en": "Sometimes"}}, {"v": 4, "label": {"ar": "غالبًا", "en": "Often"}}, {"v": 5, "label": {"ar": "دائمًا", "en": "Always"}}]}, {"text": {"ar": "أجد أعذارًا سريعة بدل الاعتراف بخطئي.", "en": "I quickly find excuses instead of admitting I was wrong."}, "group": "defensiveness", "options": [{"v": 1, "label": {"ar": "أبدًا", "en": "Never"}}, {"v": 2, "label": {"ar": "نادرًا", "en": "Rarely"}}, {"v": 3, "label": {"ar": "أحيانًا", "en": "Sometimes"}}, {"v": 4, "label": {"ar": "غالبًا", "en": "Often"}}, {"v": 5, "label": {"ar": "دائمًا", "en": "Always"}}]}, {"text": {"ar": "أشعر أنني ضحية في معظم الخلافات مهما حدث.", "en": "I feel like a victim in most disagreements no matter what happens."}, "group": "defensiveness", "options": [{"v": 1, "label": {"ar": "أبدًا", "en": "Never"}}, {"v": 2, "label": {"ar": "نادرًا", "en": "Rarely"}}, {"v": 3, "label": {"ar": "أحيانًا", "en": "Sometimes"}}, {"v": 4, "label": {"ar": "غالبًا", "en": "Often"}}, {"v": 5, "label": {"ar": "دائمًا", "en": "Always"}}]}, {"text": {"ar": "أرفض تحمل أي مسؤولية عن المشكلة حتى لو كان لي دور فيها.", "en": "I refuse to take any responsibility for a problem even if I played a part in it."}, "group": "defensiveness", "options": [{"v": 1, "label": {"ar": "أبدًا", "en": "Never"}}, {"v": 2, "label": {"ar": "نادرًا", "en": "Rarely"}}, {"v": 3, "label": {"ar": "أحيانًا", "en": "Sometimes"}}, {"v": 4, "label": {"ar": "غالبًا", "en": "Often"}}, {"v": 5, "label": {"ar": "دائمًا", "en": "Always"}}]}, {"text": {"ar": "أنسحب من النقاش وأصمت تمامًا بدل مواجهة الموضوع.", "en": "I withdraw from the discussion and go completely silent instead of facing the issue."}, "group": "stonewalling", "options": [{"v": 1, "label": {"ar": "أبدًا", "en": "Never"}}, {"v": 2, "label": {"ar": "نادرًا", "en": "Rarely"}}, {"v": 3, "label": {"ar": "أحيانًا", "en": "Sometimes"}}, {"v": 4, "label": {"ar": "غالبًا", "en": "Often"}}, {"v": 5, "label": {"ar": "دائمًا", "en": "Always"}}]}, {"text": {"ar": "أتجاهل شريكي أو أغادر الغرفة عند التوتر بدل التعامل مع الموقف.", "en": "I ignore my partner or leave the room when tense, instead of dealing with the situation."}, "group": "stonewalling", "options": [{"v": 1, "label": {"ar": "أبدًا", "en": "Never"}}, {"v": 2, "label": {"ar": "نادرًا", "en": "Rarely"}}, {"v": 3, "label": {"ar": "أحيانًا", "en": "Sometimes"}}, {"v": 4, "label": {"ar": "غالبًا", "en": "Often"}}, {"v": 5, "label": {"ar": "دائمًا", "en": "Always"}}]}, {"text": {"ar": "أشعر أنني \"أُغلق\" عاطفيًا ولا أرد حين يتصاعد الخلاف.", "en": "I feel myself \"shutting down\" emotionally and not responding when a conflict escalates."}, "group": "stonewalling", "options": [{"v": 1, "label": {"ar": "أبدًا", "en": "Never"}}, {"v": 2, "label": {"ar": "نادرًا", "en": "Rarely"}}, {"v": 3, "label": {"ar": "أحيانًا", "en": "Sometimes"}}, {"v": 4, "label": {"ar": "غالبًا", "en": "Often"}}, {"v": 5, "label": {"ar": "دائمًا", "en": "Always"}}]}], "mode": "grouped_sum", "groups": {"criticism": {"weight": 1, "label": {"ar": "النقد الشخصي", "en": "Personal Criticism"}}, "contempt": {"weight": 1, "label": {"ar": "الازدراء", "en": "Contempt"}}, "defensiveness": {"weight": 1, "label": {"ar": "الدفاعية", "en": "Defensiveness"}}, "stonewalling": {"weight": 1, "label": {"ar": "الانسحاب الصامت", "en": "Stonewalling"}}}, "bands": [{"min": 15, "max": 29, "cls": "high", "label": {"ar": "مؤشرات منخفضة (نمط صحي)", "en": "Low indicators (healthy pattern)"}, "text": {"ar": "أنماط جوتمان الأربعة الخطرة نادرة جدًا في خلافاتكما، وهذا مؤشر ممتاز على صحة أسلوب التواصل.", "en": "These four risky Gottman patterns are very rare in your disagreements — an excellent sign of healthy communication."}, "training": {"ar": "استمرا في التعبير عن الانزعاج بصيغة \"أنا أشعر\" بدل الانتقاد الشخصي.", "en": "Keep expressing frustration with \"I feel\" language instead of personal criticism."}}, {"min": 30, "max": 44, "cls": "mid", "label": {"ar": "مؤشرات طفيفة", "en": "Slight indicators"}, "text": {"ar": "تظهر بعض هذه الأنماط أحيانًا لكنها ليست مسيطرة على علاقتكما.", "en": "These patterns show up sometimes but don't dominate your relationship."}, "training": {"ar": "انتبها للحظات التي تتحول فيها الملاحظة إلى انتقاد شخصي أو سخرية، وحاولا استبدالها بعبارات محايدة.", "en": "Watch for moments when a remark turns into personal criticism or sarcasm, and try replacing it with neutral language."}}, {"min": 45, "max": 59, "cls": "mid", "label": {"ar": "مؤشرات متوسطة (تستحق انتباهًا)", "en": "Moderate indicators (worth attention)"}, "text": {"ar": "هذه الأنماط تظهر بتكرار ملحوظ في خلافاتكما، وقد بدأت تؤثر على جودة التواصل.", "en": "These patterns appear noticeably often in your disagreements and have started affecting communication quality."}, "training": {"ar": "حدّدا أي الأنماط الأربعة الأكثر حضورًا لديكما من التفصيل أدناه، وابدآ بالتعامل معه أولاً، وربما تفيد استشارة زوجية.", "en": "Identify which of the four patterns is most present for you from the breakdown below, and start addressing it first — couples counseling may help too."}}, {"min": 60, "max": 75, "cls": "low", "label": {"ar": "مؤشرات مرتفعة (خطر على استقرار العلاقة)", "en": "High indicators (risk to relationship stability)"}, "text": {"ar": "وفق أبحاث جوتمان، الحضور المتكرر لهذه الأنماط الأربعة من أقوى مؤشرات تدهور العلاقة إن لم تُعالج.", "en": "According to Gottman's research, frequent presence of these four patterns is one of the strongest predictors of relationship decline if left unaddressed."}, "training": {"ar": "ننصح بشدة باستشارة معالج زوجي مختص للعمل على استبدال هذه الأنماط بمهارات تواصل صحية.", "en": "We strongly recommend consulting a couples therapist to work on replacing these patterns with healthy communication skills."}}], "showBreakdown": true};
---

<Layout title="Psychological Test | SHYM356.ORG">
<div class="arch">
	<button class="lang-toggle" id="lang-toggle-btn" onclick="toggleLang()">English</button>
	<div class="eyebrow"><span class="t-ar">سلوكي</span><span class="t-en">Behavioral</span> · <span class="t-ar">اختبارات نفسية وسلوكية للمتزوجين</span><span class="t-en">Psychological & Behavioral Tests for Married Couples</span></div>
	
<h1><span class="t-ar">اختبار فرسان جوتمان الأربعة</span><span class="t-en">Gottman's Four Horsemen Test</span></h1>
	<p class="en">Gottman's Four Horsemen Test</p>
	<a href="/psychological-tests" class="backlink"><span class="t-ar">↩ العودة لكل الاختبارات</span><span class="t-en">↩ Back to all tests</span></a>
</div>

<div class="wrap">

	<div id="intro-section">
		 <div class="card">
		   <h2 class="section-title"><span class="t-ar">ما الهدف من هذا الاختبار؟</span><span class="t-en">What is the goal of this test?</span></h2>
		   <p><span class="t-ar">الباحث الأمريكي جون جوتمان حدد أربعة أنماط سلوكية في الخلاف تتنبأ بتدهور العلاقة بدقة عالية: النقد الشخصي، الازدراء، الدفاعية، والانسحاب الصامت. سمّاها "فرسان القيامة الأربعة" لأن ظهورها المتكرر ينذر بخطر حقيقي.</span><span class="t-en">American researcher John Gottman identified four behavior patterns in conflict that predict relationship breakdown with high accuracy: personal criticism, contempt, defensiveness, and stonewalling. He called them "the Four Horsemen" because their repeated presence signals real danger.</span></p><p><span class="t-ar">هذا الاختبار يساعدك تكتشف: هل تتسلل هذه الأنماط الأربعة إلى خلافاتكما، وأيها الأكثر حضورًا؟</span><span class="t-en">This test helps you discover: are these four patterns creeping into your disagreements, and which one shows up most?</span></p>
		 </div>
		 <div class="card">
		   <h2 class="section-title"><span class="t-ar">الفائدة المرجوة</span><span class="t-en">Expected benefit</span></h2>
		   <ul class="benefits"><li><span class="t-ar">يساعدك على التعرف على الأنماط الأخطر في أسلوب الخلاف قبل أن تتجذر.</span><span class="t-en">Helps you recognize the most damaging conflict patterns before they take root.</span></li><li><span class="t-ar">يوضح أي الأنماط الأربعة الأكثر حضورًا في علاقتكما تحديدًا.</span><span class="t-en">Shows exactly which of the four patterns is most present in your relationship.</span></li><li><span class="t-ar">يفتح الباب لاستبدال هذه الأنماط بمهارات تواصل أثبتت الأبحاث فعاليتها.</span><span class="t-en">Opens the way to replacing these patterns with communication skills proven effective by research.</span></li></ul>
		 </div>
		 <div class="card">
		   <h2 class="section-title"><span class="t-ar">طريقة الإجابة</span><span class="t-en">How to answer</span></h2>
		   <p style="font-size:14.5px"><span class="t-ar">أجب بصدق حسب تكرار حدوث كل سلوك في خلافاتكما مؤخرًا.</span><span class="t-en">Answer honestly based on how often each behavior has occurred in your recent disagreements.</span></p>
		   <div class="disclaimer"><b><span class="t-ar">تنبيه:</span><span class="t-en">Note:</span></b> <span class="t-ar">هذا الاختبار أداة توعية مبسطة لفتح الحوار بينك وبين شريك حياتك، وليس أداة تشخيص طبي أو نفسي. النتيجة انطباع أولي فقط، ولا تُغني عن استشارة مختص نفسي أو أسري أو طبي عند الحاجة.</span><span class="t-en">This test is a simplified awareness tool meant to open a conversation between you and your partner. It is not a medical or psychological diagnostic instrument. The result is only an initial impression and does not replace consulting a psychologist, family counselor, or physician when needed.</span></div>
		   <button class="start-btn" onclick="startQuiz()"><span class="t-ar">ابدأ الاختبار (15 سؤالاً)</span><span class="t-en">Start the test (15 questions)</span></button>
		 </div>
	</div>

	<div id="quiz-section" class="card">
		 <div class="progress-wrap">
		   <div class="progress-track"><div class="progress-fill" id="progress-fill"></div></div>
		   <div class="progress-label" id="progress-label"><span class="t-ar">تمت الإجابة على 0 سؤال</span><span class="t-en">Answered 0 questions</span></div>
		 </div>
		 <div class="questions-list"></div>
		 <button class="submit-btn" onclick="submitQuiz()"><span class="t-ar">عرض النتيجة</span><span class="t-en">Show my result</span></button>
	</div>

	<div id="result-section" class="card">
		 <h2 class="section-title"><span class="t-ar">نتيجتك</span><span class="t-en">Your result</span></h2>
		 <div class="result-content"></div>
		 <div class="disclaimer"><b><span class="t-ar">تنبيه:</span><span class="t-en">Note:</span></b> <span class="t-ar">هذا الاختبار أداة توعية مبسطة لفتح الحوار بينك وبين شريك حياتك، وليس أداة تشخيص طبي أو نفسي. النتيجة انطباع أولي فقط، ولا تُغني عن استشارة مختص نفسي أو أسري أو طبي عند الحاجة.</span><span class="t-en">This test is a simplified awareness tool meant to open a conversation between you and your partner. It is not a medical or psychological diagnostic instrument. The result is only an initial impression and does not replace consulting a psychologist, family counselor, or physician when needed.</span></div>
		 <button class="reset-btn" onclick="resetQuiz()"><span class="t-ar">إعادة الاختبار</span><span class="t-en">Retake the test</span></button>
	</div>

	<footer class="site-footer">
		 <p><span class="t-ar">من سلسلة "التدريبات العملية لتحسين العلاقة الزوجية"</span><span class="t-en">From the "Practical Exercises to Improve Your Marital Relationship" series</span></p>
		 <p><a href="/psychological-tests/attachment-style"><span class="t-ar">الاختبار السابق</span><span class="t-en">Previous test</span></a> · <a href="/psychological-tests"><span class="t-ar">كل الاختبارات</span><span class="t-en">All tests</span></a> · <a href="/psychological-tests/trust-scale"><span class="t-ar">الاختبار التالي</span><span class="t-en">Next test</span></a></p>
	</footer>

</div>
</Layout>

<script define:vars={{ CONFIG }}>
function bi(ar, en){
  return '<span class="t-ar">'+ar+'</span><span class="t-en">'+(en||ar)+'</span>';
}

function setLang(lang){
  document.documentElement.setAttribute('lang', lang);
  document.documentElement.setAttribute('dir', lang==='en' ? 'ltr' : 'rtl');
  try{ localStorage.setItem('siteLang', lang); }catch(e){}
  var btn = document.getElementById('lang-toggle-btn');
  if(btn){ btn.textContent = (lang==='en') ? 'العربية' : 'English'; }

  if(typeof window.renderQuestionsGlobal === 'function'){
    window.renderQuestionsGlobal();
  }

  window.dispatchEvent(new CustomEvent('languageChanged', { detail: { lang: lang } }));
}

function toggleLang(){
  var cur = document.documentElement.getAttribute('lang') || 'ar';
  setLang(cur === 'en' ? 'ar' : 'en');
}

window.addEventListener('languageChanged', function(e) {
  var newLang = e.detail && e.detail.lang;
  if(newLang){
    var btn = document.getElementById('lang-toggle-btn');
    if(btn){ btn.textContent = (newLang==='en') ? 'العربية' : 'English'; }
    if(typeof window.renderQuestionsGlobal === 'function'){
      window.renderQuestionsGlobal();
    }
  }
});

(function initLangOnLoad(){
  var saved = null;
  try{ saved = localStorage.getItem('siteLang'); }catch(e){}
  if(saved === 'en' || saved === 'ar'){
    document.addEventListener('DOMContentLoaded', function(){ setLang(saved); });
  }
})();

function initQuiz(CONFIG){
  var answers = {};
  var qSection = document.getElementById('quiz-section');
  var introSection = document.getElementById('intro-section');
  var resultSection = document.getElementById('result-section');
  var progressFill = document.getElementById('progress-fill');
  var progressLabel = document.getElementById('progress-label');
  var total = CONFIG.questions.length;

  var currentLang = document.documentElement.getAttribute('lang') || 'ar';
  document.documentElement.setAttribute('lang', currentLang);
  document.documentElement.setAttribute('dir', currentLang==='en' ? 'ltr' : 'rtl');

  function progressText(n){
    return bi('تمت الإجابة على '+n+' من '+total+' سؤال', 'Answered '+n+' of '+total+' questions');
  }

function renderQuestions(){
    var html = '';
    CONFIG.questions.forEach(function(q, i){
      html += '<div class="question" id="q-wrap-'+i+'">';
      html += '<div class="q-text"><span class="q-num">'+(i+1)+'</span><span>'+bi(q.text.ar, q.text.en)+'</span></div>';
      html += '<div class="options">';
      q.options.forEach(function(opt, oi){
        var checked = answers[i] === opt.v ? 'checked' : '';
        html += '<label class="opt" id="opt-'+i+'-'+oi+'">'+
                '<input type="radio" name="q'+i+'" value="'+opt.v+'" onchange="quizAnswer('+i+','+oi+','+opt.v+')" '+checked+'>'+
                '<span>'+bi(opt.label.ar, opt.label.en)+'</span></label>';
      });
      html += '</div></div>';
    });
    qSection.querySelector('.questions-list').innerHTML = html;

    Object.keys(answers).forEach(function(qIndex){
      var wrap = document.getElementById('q-wrap-'+qIndex);
      if(wrap){
        var opts = wrap.querySelectorAll('.opt');
        opts.forEach(function(o){ o.classList.remove('checked'); });
        var selectedOpt = wrap.querySelector('input[value="'+answers[qIndex]+'"]');
        if(selectedOpt){
          selectedOpt.parentElement.classList.add('checked');
          wrap.classList.remove('missing');
        }
      }
    });
  }

  window.renderQuestionsGlobal = renderQuestions;

  window.quizAnswer = function(qIndex, optIndex, value){
    answers[qIndex] = value;
    var wrap = document.getElementById('q-wrap-'+qIndex);
    var opts = wrap.querySelectorAll('.opt');
    opts.forEach(function(o){ o.classList.remove('checked'); });
    document.getElementById('opt-'+qIndex+'-'+optIndex).classList.add('checked');
    wrap.classList.remove('missing');
    updateProgress();
  };

  function updateProgress(){
    var answered = Object.keys(answers).length;
    var pct = Math.round((answered/total)*100);
    progressFill.style.width = pct+'%';
    progressLabel.innerHTML = progressText(answered);
  }

  window.startQuiz = function(){
    introSection.style.display = 'none';
    qSection.style.display = 'block';
    window.scrollTo({top:0, behavior:'smooth'});
  };

  window.submitQuiz = function(){
    var missing = [];
    for(var i=0;i<total;i++){
      if(!(i in answers)) missing.push(i);
    }
    if(missing.length){
      var first = document.getElementById('q-wrap-'+missing[0]);
      missing.forEach(function(i){
        document.getElementById('q-wrap-'+i).classList.add('missing');
      });
      first.scrollIntoView({behavior:'smooth', block:'center'});
      return;
    }
    computeAndShowResult();
  };

  function groupTotal(groupName){
    var sum = 0;
    CONFIG.questions.forEach(function(q,i){
      if((q.group||'main') === groupName) sum += answers[i];
    });
    return sum;
  }

  function pickBand(score, bands){
    for(var i=0;i<bands.length;i++){
      var b = bands[i];
      if(score >= b.min && score <= b.max) return b;
    }
    return bands[bands.length-1];
  }

  function computeAndShowResult(){
    var html = '';
    if(CONFIG.mode === 'grouped_sum'){
      var overall = 0;
      var breakdownHtml = '';
      Object.keys(CONFIG.groups).forEach(function(g){
        var raw = groupTotal(g);
        var weight = CONFIG.groups[g].weight || 1;
        var val = raw * weight;
        overall += val;
        if(CONFIG.groups[g].label){
          breakdownHtml += '<li>'+bi(CONFIG.groups[g].label.ar, CONFIG.groups[g].label.en)+': '+ (Math.round(val*100)/100) +'</li>';
        }
      });
      overall = Math.round(overall*100)/100;
      var band = pickBand(overall, CONFIG.bands);
      html += '<div class="result-badge '+band.cls+'"><span class="score">'+overall+'</span><span class="label">'+bi(band.label.ar,band.label.en)+'</span></div>';
      html += '<div class="result-text">'+bi(band.text.ar,band.text.en)+'</div>';
      if(band.training && (band.training.ar || band.training.en)){
        html += '<div class="training-box"><b>'+bi('خطوة عملية مقترحة','Practical suggested step')+'</b>'+bi(band.training.ar,band.training.en)+'</div>';
      }
      if(CONFIG.showBreakdown && breakdownHtml){
        html += '<div class="training-box"><b>'+bi('تفصيل حسب المحاور','Breakdown by domain')+'</b><ul style="margin:6px 0 0;padding-right:18px">'+breakdownHtml+'</ul></div>';
      }
    }
    resultSection.querySelector('.result-content').innerHTML = html;
    qSection.style.display = 'none';
    resultSection.style.display = 'block';
    window.scrollTo({top:0, behavior:'smooth'});
  }

  window.resetQuiz = function(){
    answers = {};
    resultSection.style.display = 'none';
    introSection.style.display = 'block';
    renderQuestions();
    updateProgress();
    window.scrollTo({top:0, behavior:'smooth'});
  };

  renderQuestions();
  updateProgress();
}
initQuiz(CONFIG);
</script>

<style is:global>
