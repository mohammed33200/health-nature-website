import Layout from '../../layouts/Layout.astro';

const CONFIG = {"questions": [{"text": {"ar": "أبدأ يومي بتحية أو كلمة لطيفة لشريكي.", "en": "I start my day with a greeting or kind word to my partner."}, "group": "main", "options": [{"v": 1, "label": {"ar": "أبدًا", "en": "Never"}}, {"v": 2, "label": {"ar": "نادرًا", "en": "Rarely"}}, {"v": 3, "label": {"ar": "أحيانًا", "en": "Sometimes"}}, {"v": 4, "label": {"ar": "غالبًا", "en": "Often"}}, {"v": 5, "label": {"ar": "دائمًا", "en": "Always"}}]}, {"text": {"ar": "أحرص أن نأكل معًا ولو وجبة واحدة يوميًا.", "en": "I make sure we eat together at least one meal a day."}, "group": "main", "options": [{"v": 1, "label": {"ar": "أبدًا", "en": "Never"}}, {"v": 2, "label": {"ar": "نادرًا", "en": "Rarely"}}, {"v": 3, "label": {"ar": "أحيانًا", "en": "Sometimes"}}, {"v": 4, "label": {"ar": "غالبًا", "en": "Often"}}, {"v": 5, "label": {"ar": "دائمًا", "en": "Always"}}]}, {"text": {"ar": "أستخدم اللمس (يد، كتف، عناق) بشكل عفوي خلال اليوم.", "en": "I use touch (hand, shoulder, hug) spontaneously throughout the day."}, "group": "main", "options": [{"v": 1, "label": {"ar": "أبدًا", "en": "Never"}}, {"v": 2, "label": {"ar": "نادرًا", "en": "Rarely"}}, {"v": 3, "label": {"ar": "أحيانًا", "en": "Sometimes"}}, {"v": 4, "label": {"ar": "غالبًا", "en": "Often"}}, {"v": 5, "label": {"ar": "دائمًا", "en": "Always"}}]}, {"text": {"ar": "أشارك شريكي تفاصيل يومي الصغيرة، حتى لو كانت بسيطة.", "en": "I share the small details of my day with my partner, even simple ones."}, "group": "main", "options": [{"v": 1, "label": {"ar": "أبدًا", "en": "Never"}}, {"v": 2, "label": {"ar": "نادرًا", "en": "Rarely"}}, {"v": 3, "label": {"ar": "أحيانًا", "en": "Sometimes"}}, {"v": 4, "label": {"ar": "غالبًا", "en": "Often"}}, {"v": 5, "label": {"ar": "دائمًا", "en": "Always"}}]}, {"text": {"ar": "أستمع بتركيز عندما يتحدث شريكي دون هاتف أو مقاطعة.", "en": "I listen attentively when my partner talks, without a phone or interruption."}, "group": "main", "options": [{"v": 1, "label": {"ar": "أبدًا", "en": "Never"}}, {"v": 2, "label": {"ar": "نادرًا", "en": "Rarely"}}, {"v": 3, "label": {"ar": "أحيانًا", "en": "Sometimes"}}, {"v": 4, "label": {"ar": "غالبًا", "en": "Often"}}, {"v": 5, "label": {"ar": "دائمًا", "en": "Always"}}]}, {"text": {"ar": "أرسل رسالة قصيرة أو مكالمة لأطمئن عليه خلال اليوم.", "en": "I send a quick message or call to check on them during the day."}, "group": "main", "options": [{"v": 1, "label": {"ar": "أبدًا", "en": "Never"}}, {"v": 2, "label": {"ar": "نادرًا", "en": "Rarely"}}, {"v": 3, "label": {"ar": "أحيانًا", "en": "Sometimes"}}, {"v": 4, "label": {"ar": "غالبًا", "en": "Often"}}, {"v": 5, "label": {"ar": "دائمًا", "en": "Always"}}]}, {"text": {"ar": "أخصّص وقتًا ثابتًا، ولو دقائق، نتحدث فيه بلا مقاطعة.", "en": "I set aside fixed time, even a few minutes, to talk without interruption."}, "group": "main", "options": [{"v": 1, "label": {"ar": "أبدًا", "en": "Never"}}, {"v": 2, "label": {"ar": "نادرًا", "en": "Rarely"}}, {"v": 3, "label": {"ar": "أحيانًا", "en": "Sometimes"}}, {"v": 4, "label": {"ar": "غالبًا", "en": "Often"}}, {"v": 5, "label": {"ar": "دائمًا", "en": "Always"}}]}, {"text": {"ar": "أحرص على قول \"شكرًا\" حتى على الأشياء الصغيرة.", "en": "I make sure to say \"thank you\" even for small things."}, "group": "main", "options": [{"v": 1, "label": {"ar": "أبدًا", "en": "Never"}}, {"v": 2, "label": {"ar": "نادرًا", "en": "Rarely"}}, {"v": 3, "label": {"ar": "أحيانًا", "en": "Sometimes"}}, {"v": 4, "label": {"ar": "غالبًا", "en": "Often"}}, {"v": 5, "label": {"ar": "دائمًا", "en": "Always"}}]}, {"text": {"ar": "أمدح شريكي بصدق وأذكر ما يعجبني فيه.", "en": "I sincerely compliment my partner and mention what I like about them."}, "group": "main", "options": [{"v": 1, "label": {"ar": "أبدًا", "en": "Never"}}, {"v": 2, "label": {"ar": "نادرًا", "en": "Rarely"}}, {"v": 3, "label": {"ar": "أحيانًا", "en": "Sometimes"}}, {"v": 4, "label": {"ar": "غالبًا", "en": "Often"}}, {"v": 5, "label": {"ar": "دائمًا", "en": "Always"}}]}, {"text": {"ar": "أشارك شريكي أنشطتي المفضلة أو أشاركه أنشطته.", "en": "I share my favorite activities with my partner or join theirs."}, "group": "main", "options": [{"v": 1, "label": {"ar": "أبدًا", "en": "Never"}}, {"v": 2, "label": {"ar": "نادرًا", "en": "Rarely"}}, {"v": 3, "label": {"ar": "أحيانًا", "en": "Sometimes"}}, {"v": 4, "label": {"ar": "غالبًا", "en": "Often"}}, {"v": 5, "label": {"ar": "دائمًا", "en": "Always"}}]}, {"text": {"ar": "أضحك معه وأبحث عن مواقف مرحة نعيشها معًا.", "en": "I laugh with them and look for fun moments to share."}, "group": "main", "options": [{"v": 1, "label": {"ar": "أبدًا", "en": "Never"}}, {"v": 2, "label": {"ar": "نادرًا", "en": "Rarely"}}, {"v": 3, "label": {"ar": "أحيانًا", "en": "Sometimes"}}, {"v": 4, "label": {"ar": "غالبًا", "en": "Often"}}, {"v": 5, "label": {"ar": "دائمًا", "en": "Always"}}]}, {"text": {"ar": "أعبّر عن اشتياقي عندما يغيب.", "en": "I express that I miss them when they're away."}, "group": "main", "options": [{"v": 1, "label": {"ar": "أبدًا", "en": "Never"}}, {"v": 2, "label": {"ar": "نادرًا", "en": "Rarely"}}, {"v": 3, "label": {"ar": "أحيانًا", "en": "Sometimes"}}, {"v": 4, "label": {"ar": "غالبًا", "en": "Often"}}, {"v": 5, "label": {"ar": "دائمًا", "en": "Always"}}]}, {"text": {"ar": "أشارك شريكي قرارًا صغيرًا مثل اختيار وجبة أو فيلم.", "en": "I involve my partner in small decisions like choosing a meal or a film."}, "group": "main", "options": [{"v": 1, "label": {"ar": "أبدًا", "en": "Never"}}, {"v": 2, "label": {"ar": "نادرًا", "en": "Rarely"}}, {"v": 3, "label": {"ar": "أحيانًا", "en": "Sometimes"}}, {"v": 4, "label": {"ar": "غالبًا", "en": "Often"}}, {"v": 5, "label": {"ar": "دائمًا", "en": "Always"}}]}, {"text": {"ar": "أحرص أن يكون بيننا طقس خاص (مثل شاي المساء معًا).", "en": "I make sure we have a special ritual (like evening tea together)."}, "group": "main", "options": [{"v": 1, "label": {"ar": "أبدًا", "en": "Never"}}, {"v": 2, "label": {"ar": "نادرًا", "en": "Rarely"}}, {"v": 3, "label": {"ar": "أحيانًا", "en": "Sometimes"}}, {"v": 4, "label": {"ar": "غالبًا", "en": "Often"}}, {"v": 5, "label": {"ar": "دائمًا", "en": "Always"}}]}, {"text": {"ar": "أختار في بعض الأوقات أن أترك انشغالي لأعطيه أولوية.", "en": "I sometimes choose to set aside my own busy schedule to prioritize them."}, "group": "main", "options": [{"v": 1, "label": {"ar": "أبدًا", "en": "Never"}}, {"v": 2, "label": {"ar": "نادرًا", "en": "Rarely"}}, {"v": 3, "label": {"ar": "أحيانًا", "en": "Sometimes"}}, {"v": 4, "label": {"ar": "غالبًا", "en": "Often"}}, {"v": 5, "label": {"ar": "دائمًا", "en": "Always"}}]}], "mode": "sum", "bands": [{"min": 60, "max": 75, "cls": "high", "label": {"ar": "قرب عالٍ", "en": "High closeness"}, "text": {"ar": "أنت وشريكك قريبان جدًا، وعاداتكما اليومية تبني علاقة دافئة ومستقرة.", "en": "You and your partner are very close, and your daily habits build a warm, stable relationship."}, "training": {"ar": "استمرا في هذه العادات، وأضيفا طقسًا أسبوعيًا جديدًا بين الحين والآخر لتجديد الأجواء.", "en": "Keep it up, and occasionally add a new weekly ritual to refresh things."}}, {"min": 45, "max": 59, "cls": "mid", "label": {"ar": "أساس جيد", "en": "Good foundation"}, "text": {"ar": "لديكما أساس جيد، لكن تحتاجان تعزيز بعض التفاصيل مثل تخصيص وقت يومي أو التعبير عن الشكر.", "en": "You have a good foundation, but need to reinforce some details like setting aside daily time or expressing gratitude."}, "training": {"ar": "اختارا عادة واحدة ناقصة من القائمة أعلاه وطبّقاها هذا الأسبوع بثبات.", "en": "Pick one missing habit from the list above and apply it consistently this week."}}, {"min": 30, "max": 44, "cls": "low", "label": {"ar": "يحتاج انتعاشًا", "en": "Needs revival"}, "text": {"ar": "القرب بينكما يحتاج انتعاشًا، فالروتين اليومي ربما يطغى على العلاقة.", "en": "Your closeness needs revival — daily routine may be overshadowing the relationship."}, "training": {"ar": "حاولا تبنّي عادة واحدة جديدة يوميًا من القائمة أعلاه لمدة أسبوعين ثم قيّما الفرق.", "en": "Try adopting one new habit from the list above daily for two weeks, then assess the difference."}}, {"min": 15, "max": 29, "cls": "low", "label": {"ar": "يفتقد للدفء اليومي", "en": "Missing daily warmth"}, "text": {"ar": "العلاقة تفتقد للدفء اليومي، وأنتما بحاجة فورية لإحياء العادات الصغيرة.", "en": "The relationship lacks daily warmth, and you need to urgently revive small connecting habits."}, "training": {"ar": "ابدآ بأصغر خطوة ممكنة اليوم (تحية صباحية أو رسالة قصيرة)، فالعادات الصغيرة المتكررة هي ما يعيد الدفء تدريجيًا.", "en": "Start with the smallest possible step today (a morning greeting or a quick text) — small, repeated habits are what gradually rebuild warmth."}}]};
---

<Layout title="Psychological Test | SHYM356.ORG">
<div class="arch">
	<button class="lang-toggle" id="lang-toggle-btn" onclick="toggleLang()">English</button>
	<div class="eyebrow"><span class="t-ar">سلوكي</span><span class="t-en">Behavioral</span> · <span class="t-ar">اختبارات نفسية وسلوكية للمتزوجين</span><span class="t-en">Psychological & Behavioral Tests for Married Couples</span></div>
	
<h1><span class="t-ar">اختبار التوازن بين العمل والزواج</span><span class="t-en">Work-Life-Marriage Balance Test</span></h1>
	<p class="en">Work-Life-Marriage Balance Test</p>
	<a href="/psychological-tests" class="backlink"><span class="t-ar">↩ العودة لكل الاختبارات</span><span class="t-en">↩ Back to all tests</span></a>
</div>

<div class="wrap">

	<div id="intro-section">
		 <div class="card">
		   <h2 class="section-title"><span class="t-ar">ما الهدف من هذا الاختبار؟</span><span class="t-en">What is the goal of this test?</span></h2>
		   <p><span class="t-ar">العلاقات لا تنهار فجأة، بل تضعف بالتدريج حين تختفي التفاصيل الصغيرة التي كانت تقرّب الزوجين.</span><span class="t-en">Relationships don't collapse suddenly — they weaken gradually when the small details that used to bring spouses closer disappear.</span></p><p><span class="t-ar">هذا الاختبار يساعدك تعرف: هل تحافظ على العادات البسيطة التي تبني القرب؟ وهل روتينك اليومي يدعم العلاقة أم يبعدها؟</span><span class="t-en">This test helps you find out: do you maintain the simple habits that build closeness? And does your daily routine support the relationship or push it away?</span></p>
		 </div>
		 <div class="card">
		   <h2 class="section-title"><span class="t-ar">الفائدة المرجوة</span><span class="t-en">Expected benefit</span></h2>
		   <ul class="benefits"><li><span class="t-ar">يكشف إذا كانت علاقتك تسير على "وضع الطيار الآلي" أو ما زالت مليئة بالتواصل.</span><span class="t-en">Reveals whether your relationship is running on "autopilot" or is still full of connection.</span></li><li><span class="t-ar">يساعدك على تحديد عادات بسيطة يمكن إضافتها يوميًا.</span><span class="t-en">Helps you identify simple habits you can add daily.</span></li><li><span class="t-ar">أداة سهلة للأزواج الذين يشعرون بالبعد رغم غياب المشاكل الكبيرة.</span><span class="t-en">An easy tool for couples who feel distant despite the absence of major problems.</span></li></ul>
		 </div>
		 <div class="card">
		   <h2 class="section-title"><span class="t-ar">طريقة الإجابة</span><span class="t-en">How to answer</span></h2>
		   <p style="font-size:14.5px"><span class="t-ar">اقرأ الموقف واختر الإجابة الأقرب لك.</span><span class="t-en">Read each situation and choose the closest answer.</span></p>
		   <div class="disclaimer"><b><span class="t-ar">تنبيه:</span><span class="t-en">Note:</span></b> <span class="t-ar">هذا الاختبار أداة توعية مبسطة لفتح الحوار بينك وبين شريك حياتك، وليس أداة تشخيص طبي أو نفسي. النتيجة انطباع أولي فقط، ولا تُغني عن استشارة مختص نفسي أو أسري أو طبي عند الحاجة.</span><span class="t-en">This test is a simplified awareness tool meant to open a conversation between you and your partner. It is not a medical or psychological diagnostic instrument. The result is only an initial impression and does not replace consulting a psychologist, family counselor, or physician when needed.</span></div>
		   <button class="start-btn" onclick="startQuiz()"><span class="t-ar">ابدأ الاختبار (15 سؤالاً)</span><span class="t-en">Start the test (15 questions)</span></button>
		 </div>
	</div>

	<div id="quiz-section" class="card">
		 <div class="progress-wrap">
		   <div class="progress-track"><div class="progress-fill" id="progress-fill"></div></div>
		   <div class="progress-label" id="progress-label"><span class="t-ar">تمت الإجابة على 0 سؤال</span><span class="t-en">Answered 0 questions</span></div>
		 </div>
		 <div class="questions-list"></div>
		 <button class="submit-btn" onclick="submitQuiz()"><span class="t-ar">عرض النتيجة</span><span class="t-en">Show my result</span></button>
	</div>

	<div id="result-section" class="card">
		 <h2 class="section-title"><span class="t-ar">نتيجتك</span><span class="t-en">Your result</span></h2>
		 <div class="result-content"></div>
		 <div class="disclaimer"><b><span class="t-ar">تنبيه:</span><span class="t-en">Note:</span></b> <span class="t-ar">هذا الاختبار أداة توعية مبسطة لفتح الحوار بينك وبين شريك حياتك، وليس أداة تشخيص طبي أو نفسي. النتيجة انطباع أولي فقط، ولا تُغني عن استشارة مختص نفسي أو أسري أو طبي عند الحاجة.</span><span class="t-en">This test is a simplified awareness tool meant to open a conversation between you and your partner. It is not a medical or psychological diagnostic instrument. The result is only an initial impression and does not replace consulting a psychologist, family counselor, or physician when needed.</span></div>
		 <button class="reset-btn" onclick="resetQuiz()"><span class="t-ar">إعادة الاختبار</span><span class="t-en">Retake the test</span></button>
	</div>

	<footer class="site-footer">
		 <p><span class="t-ar">من سلسلة "التدريبات العملية لتحسين العلاقة الزوجية"</span><span class="t-en">From the "Practical Exercises to Improve Your Marital Relationship" series</span></p>
		 <p><a href="/psychological-tests/intimacy-habits"><span class="t-ar">الاختبار السابق</span><span class="t-en">Previous test</span></a> · <a href="/psychological-tests"><span class="t-ar">كل الاختبارات</span><span class="t-en">All tests</span></a> · <a href="/psychological-tests/parenting-styles-compatibility"><span class="t-ar">الاختبار التالي</span><span class="t-en">Next test</span></a></p>
	</footer>

</div>
</Layout>

<script define:vars={{ CONFIG }}>
function bi(ar, en){
  return '<span class="t-ar">'+ar+'</span><span class="t-en">'+(en||ar)+'</span>';
}

function setLang(lang){
  document.documentElement.setAttribute('lang', lang);
  document.documentElement.setAttribute('dir', lang==='en' ? 'ltr' : 'rtl');
  try{ localStorage.setItem('siteLang', lang); }catch(e){}
  var btn = document.getElementById('lang-toggle-btn');
  if(btn){ btn.textContent = (lang==='en') ? 'العربية' : 'English'; }

  if(typeof window.renderQuestionsGlobal === 'function'){
    window.renderQuestionsGlobal();
  }

  window.dispatchEvent(new CustomEvent('languageChanged', { detail: { lang: lang } }));
}

function toggleLang(){
  var cur = document.documentElement.getAttribute('lang') || 'ar';
  setLang(cur === 'en' ? 'ar' : 'en');
}

window.addEventListener('languageChanged', function(e) {
  var newLang = e.detail && e.detail.lang;
  if(newLang){
    var btn = document.getElementById('lang-toggle-btn');
    if(btn){ btn.textContent = (newLang==='en') ? 'العربية' : 'English'; }
    if(typeof window.renderQuestionsGlobal === 'function'){
      window.renderQuestionsGlobal();
    }
  }
});

(function initLangOnLoad(){
  var saved = null;
  try{ saved = localStorage.getItem('siteLang'); }catch(e){}
  if(saved === 'en' || saved === 'ar'){
    document.addEventListener('DOMContentLoaded', function(){ setLang(saved); });
  }
})();

function initQuiz(CONFIG){
  var answers = {};
  var qSection = document.getElementById('quiz-section');
  var introSection = document.getElementById('intro-section');
  var resultSection = document.getElementById('result-section');
  var progressFill = document.getElementById('progress-fill');
  var progressLabel = document.getElementById('progress-label');
  var total = CONFIG.questions.length;

  var currentLang = document.documentElement.getAttribute('lang') || 'ar';
  document.documentElement.setAttribute('lang', currentLang);
  document.documentElement.setAttribute('dir', currentLang==='en' ? 'ltr' : 'rtl');

  function progressText(n){
    return bi('تمت الإجابة على '+n+' من '+total+' سؤال', 'Answered '+n+' of '+total+' questions');
  }

function renderQuestions(){
    var html = '';
    CONFIG.questions.forEach(function(q, i){
      html += '<div class="question" id="q-wrap-'+i+'">';
      html += '<div class="q-text"><span class="q-num">'+(i+1)+'</span><span>'+bi(q.text.ar, q.text.en)+'</span></div>';
      html += '<div class="options">';
      q.options.forEach(function(opt, oi){
        var checked = answers[i] === opt.v ? 'checked' : '';
        html += '<label class="opt" id="opt-'+i+'-'+oi+'">'+
                '<input type="radio" name="q'+i+'" value="'+opt.v+'" onchange="quizAnswer('+i+','+oi+','+opt.v+')" '+checked+'>'+
                '<span>'+bi(opt.label.ar, opt.label.en)+'</span></label>';
      });
      html += '</div></div>';
    });
    qSection.querySelector('.questions-list').innerHTML = html;

    Object.keys(answers).forEach(function(qIndex){
      var wrap = document.getElementById('q-wrap-'+qIndex);
      if(wrap){
        var opts = wrap.querySelectorAll('.opt');
        opts.forEach(function(o){ o.classList.remove('checked'); });
        var selectedOpt = wrap.querySelector('input[value="'+answers[qIndex]+'"]');
        if(selectedOpt){
          selectedOpt.parentElement.classList.add('checked');
          wrap.classList.remove('missing');
        }
      }
    });
  }

  window.renderQuestionsGlobal = renderQuestions;

  window.quizAnswer = function(qIndex, optIndex, value){
    answers[qIndex] = value;
    var wrap = document.getElementById('q-wrap-'+qIndex);
    var opts = wrap.querySelectorAll('.opt');
    opts.forEach(function(o){ o.classList.remove('checked'); });
    document.getElementById('opt-'+qIndex+'-'+optIndex).classList.add('checked');
    wrap.classList.remove('missing');
    updateProgress();
  };

  function updateProgress(){
    var answered = Object.keys(answers).length;
    var pct = Math.round((answered/total)*100);
    progressFill.style.width = pct+'%';
    progressLabel.innerHTML = progressText(answered);
  }

  window.startQuiz = function(){
    introSection.style.display = 'none';
    qSection.style.display = 'block';
    window.scrollTo({top:0, behavior:'smooth'});
  };

  window.submitQuiz = function(){
    var missing = [];
    for(var i=0;i<total;i++){
      if(!(i in answers)) missing.push(i);
    }
    if(missing.length){
      var first = document.getElementById('q-wrap-'+missing[0]);
      missing.forEach(function(i){
        document.getElementById('q-wrap-'+i).classList.add('missing');
      });
      first.scrollIntoView({behavior:'smooth', block:'center'});
      return;
    }
    computeAndShowResult();
  };

  function groupTotal(groupName){
    var sum = 0;
    CONFIG.questions.forEach(function(q,i){
      if((q.group||'main') === groupName) sum += answers[i];
    });
    return sum;
  }

  function pickBand(score, bands){
    for(var i=0;i<bands.length;i++){
      var b = bands[i];
      if(score >= b.min && score <= b.max) return b;
    }
    return bands[bands.length-1];
  }

  function computeAndShowResult(){
    var html = '';
    var score = groupTotal('main');
    var band = pickBand(score, CONFIG.bands);
    html += '<div class="result-badge '+band.cls+'"><span class="score">'+score+'</span><span class="label">'+bi(band.label.ar,band.label.en)+'</span></div>';
    html += '<div class="result-text">'+bi(band.text.ar,band.text.en)+'</div>';
    if(band.training && (band.training.ar || band.training.en)){
      html += '<div class="training-box"><b>'+bi('خطوة عملية مقترحة','Practical suggested step')+'</b>'+bi(band.training.ar,band.training.en)+'</div>';
    }
    resultSection.querySelector('.result-content').innerHTML = html;
    qSection.style.display = 'none';
    resultSection.style.display = 'block';
    window.scrollTo({top:0, behavior:'smooth'});
  }

  window.resetQuiz = function(){
    answers = {};
    resultSection.style.display = 'none';
    introSection.style.display = 'block';
    renderQuestions();
    updateProgress();
    window.scrollTo({top:0, behavior:'smooth'});
  };

  renderQuestions();
  updateProgress();
}
initQuiz(CONFIG);
</script>

<style is:global>
