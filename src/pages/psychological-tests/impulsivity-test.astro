<style is:global>
:root{
  --bg:#FAF6F0;
  --surface:#FFFFFF;
  --ink:#2B2320;
  --muted:#8A7A6E;
  --primary:#8C3B4A;
  --primary-dark:#6E2938;
  --accent:#C99A4B;
  --success:#4C7A5E;
  --success-bg:#EEF4EF;
  --warning:#A6741C;
  --warning-bg:#FBF3E3;
  --danger:#A23B3B;
  --danger-bg:#FBEDEC;
  --line:#EDE3D8;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;
  background:var(--bg);
  color:var(--ink);
  font-family:Tahoma,'Segoe UI',Arial,sans-serif;
  line-height:1.9;
  direction:rtl;
}
.wrap{max-width:720px;margin:0 auto;padding:18px 16px 60px}
.arch{
  background:linear-gradient(180deg,var(--primary) 0%,var(--primary-dark) 100%);
  border-radius:0 0 120px 120px/0 0 60px 60px;
  padding:38px 24px 46px;
  text-align:center;
  color:#fff;
  position:relative;
  overflow:hidden;
}
.arch::before{
  content:"";
  position:absolute;inset:0;
  background:radial-gradient(circle at 50% 0%, rgba(255,255,255,.14), transparent 60%);
}
.arch .eyebrow{
  font-size:13px;letter-spacing:.5px;color:#F1D9A8;font-weight:bold;
  position:relative;
}
.arch h1{
  font-size:26px;margin:10px 0 6px;position:relative;
}
.arch p.en{
  font-size:13px;color:rgba(255,255,255,.75);margin:0;position:relative;
  direction:ltr;
}
.backlink{
  display:inline-block;margin-top:16px;color:rgba(255,255,255,.9);
  font-size:13px;text-decoration:none;border-bottom:1px dashed rgba(255,255,255,.5);
  position:relative;
}
.card{
  background:var(--surface);
  border:1px solid var(--line);
  border-radius:16px;
  padding:22px 20px;
  margin-top:-30px;
  position:relative;
  box-shadow:0 8px 24px rgba(43,35,32,.06);
}
.card + .card{margin-top:18px}
h2.section-title{
  font-size:16px;color:var(--primary-dark);margin:0 0 12px;
  display:flex;align-items:center;gap:8px;
}
h2.section-title::before{
  content:"";width:8px;height:8px;border-radius:2px;
  background:var(--accent);transform:rotate(45deg);flex:none;
}
.benefits{list-style:none;margin:0;padding:0}
.benefits li{
  padding:8px 0 8px 0;border-bottom:1px dashed var(--line);
  font-size:14.5px;color:#4a3f39;
  position:relative;padding-right:22px;
}
.benefits li:last-child{border-bottom:none}
.benefits li::before{
  content:"◆";position:absolute;right:0;top:9px;font-size:9px;color:var(--accent);
}
.disclaimer{
  background:var(--warning-bg);border:1px solid #EFD9A8;color:#6b4d10;
  border-radius:12px;padding:14px 16px;font-size:13px;margin-top:18px;
}
.disclaimer b{color:var(--warning)}
.start-btn,.submit-btn,.reset-btn{
  display:block;width:100%;border:none;cursor:pointer;
  background:var(--primary);color:#fff;font-size:16px;font-weight:bold;
  padding:15px;border-radius:12px;margin-top:20px;font-family:inherit;
  transition:background .15s;
}
.start-btn:hover,.submit-btn:hover,.reset-btn:hover{background:var(--primary-dark)}
#quiz-section{display:none}
#result-section{display:none}
.progress-wrap{
  position:sticky;top:0;background:var(--bg);padding:10px 0;z-index:5;
  margin-bottom:6px;
}
.progress-track{background:var(--line);border-radius:20px;height:8px;overflow:hidden}
.progress-fill{background:var(--accent);height:100%;width:0%;transition:width .2s}
.progress-label{font-size:12px;color:var(--muted);margin-top:6px;text-align:center}
.question{
  border-bottom:1px solid var(--line);padding:18px 0;
}
.question:last-child{border-bottom:none}
.question.missing{
  animation:shake .3s;
}
@keyframes shake{
  0%,100%{transform:translateX(0)}
  25%{transform:translateX(4px)}
  75%{transform:translateX(-4px)}
}
.q-num{
  display:inline-flex;align-items:center;justify-content:center;
  width:26px;height:26px;border-radius:50%;
  border:1.5px solid var(--accent);color:var(--primary-dark);
  font-size:12.5px;font-weight:bold;margin-left:8px;flex:none;
}
.q-text{font-size:15px;color:var(--ink);display:flex;align-items:flex-start;gap:2px;font-weight:bold}
.options{display:flex;flex-direction:column;gap:8px;margin-top:12px}
.opt{
  display:flex;align-items:center;gap:10px;
  border:1.5px solid var(--line);border-radius:10px;padding:10px 12px;
  cursor:pointer;font-size:14px;color:#4a3f39;transition:.15s;
}
.opt:hover{border-color:var(--accent)}
.opt input{accent-color:var(--primary);width:17px;height:17px;flex:none}
.opt.checked{border-color:var(--primary);background:#FBF3F0}
.result-badge{
  text-align:center;padding:22px 16px;border-radius:14px;margin-bottom:16px;
}
.result-badge.high{background:var(--success-bg);color:var(--success)}
.result-badge.mid{background:var(--warning-bg);color:var(--warning)}
.result-badge.low{background:var(--danger-bg);color:var(--danger)}
.result-badge .score{font-size:34px;font-weight:bold;display:block}
.result-badge .label{font-size:16px;font-weight:bold;margin-top:4px;display:block}
.result-text{font-size:14.5px;color:#4a3f39;margin-top:6px}
.training-box{
  background:#F7F2EA;border-radius:12px;padding:16px;margin-top:14px;
  border-right:4px solid var(--accent);
}
.training-box b{color:var(--primary-dark);display:block;margin-bottom:6px;font-size:14px}
footer.site-footer{
  text-align:center;font-size:12px;color:var(--muted);margin-top:26px;line-height:1.8;
}
footer.site-footer a{color:var(--primary)}
@media(max-width:400px){
  .arch h1{font-size:22px}
}

/* ---- bilingual toggle ---- */
html:not([lang="en"]) .t-en{display:none !important}
html[lang="en"] .t-ar{display:none !important}
html[lang="en"] body{direction:ltr}
html[lang="en"] .q-num{margin-left:0;margin-right:8px}
html[lang="en"] .benefits li{padding-right:0;padding-left:22px}
html[lang="en"] .benefits li::before{right:auto;left:0}
html[lang="en"] .training-box{border-right:none;border-left:4px solid var(--accent)}
html[lang="en"] .result-badge .score{direction:ltr}
.lang-toggle{
  position:absolute; top:14px; left:14px;
  background:rgba(255,255,255,.16); border:1px solid rgba(255,255,255,.4);
  color:#fff; font-size:12.5px; font-weight:bold; padding:7px 12px;
  border-radius:20px; cursor:pointer; z-index:9;
}
html[lang="en"] .lang-toggle{left:auto; right:14px}
.lang-toggle:hover{background:rgba(255,255,255,.28)}


html[lang="en"] .question .q-text .t-ar{display:none !important}
html[lang="en"] .question .q-text .t-en{display:inline !important}
</style>