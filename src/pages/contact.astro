<style>
	.contact-page {
		max-width: 980px;
		margin: 0 auto;
		padding: 32px 0 48px;
	}

	.hero {
		text-align: center;
		padding: 48px 32px;
		margin-bottom: 32px;
		border-radius: 32px;
		background: linear-gradient(135deg, rgba(232, 247, 236, 0.95), rgba(255, 255, 255, 0.98));
		box-shadow: 0 32px 80px rgba(15, 23, 42, 0.08);
	}

	.hero h1 {
		margin: 0 0 16px;
		font-size: clamp(2rem, 3vw, 3rem);
		color: #134e39;
	}

	.lead {
		margin: 0;
		font-size: 1.15rem;
		line-height: 1.8;
		color: #475569;
		max-width: 640px;
		margin-left: auto;
		margin-right: auto;
	}

	.contact-section {
		padding: 32px;
		margin-bottom: 24px;
		border-radius: 28px;
		background: rgba(255, 255, 255, 0.96);
		box-shadow: 0 24px 60px rgba(15, 23, 42, 0.06);
	}

	.contact-section h2 {
		margin: 0 0 12px;
		font-size: 1.8rem;
		color: #134e39;
	}

	.contact-section p {
		margin: 0 0 24px;
		color: #475569;
		line-height: 1.8;
	}

	.social-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 20px;
	}

	.social-card {
		display: flex;
		align-items: center;
		gap: 20px;
		padding: 24px;
		border-radius: 24px;
		text-decoration: none;
		color: inherit;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
		border: 1px solid rgba(56, 132, 81, 0.12);
		background: rgba(247, 251, 247, 0.9);
	}

	[dir='rtl'] .social-card {
		flex-direction: row-reverse;
	}

	.social-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 16px 40px rgba(15, 23, 42, 0.12);
	}

	.social-card .icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 64px;
		height: 64px;
		border-radius: 20px;
		flex-shrink: 0;
	}

	.social-card.youtube .icon {
		background: linear-gradient(135deg, #ff0000, #cc0000);
		color: white;
	}

	.social-card.threads .icon {
		background: linear-gradient(135deg, #000000, #333333);
		color: white;
	}

	.social-card.instagram .icon {
		background: linear-gradient(135deg, #833ab4, #fd1d1d, #fcb045);
		color: white;
	}

	.social-card.facebook .icon {
		background: linear-gradient(135deg, #1877f2, #0d5bbf);
		color: white;
	}

	.social-card h3 {
		margin: 0 0 4px;
		font-size: 1.2rem;
		color: #134e39;
	}

	.social-card p {
		margin: 0;
		color: #64748b;
		font-size: 0.95rem;
	}

	.whatsapp-button {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		padding: 16px 32px;
		border-radius: 999px;
		background: linear-gradient(135deg, #25d366, #128c7e);
		color: white;
		font-weight: 700;
		font-size: 1.1rem;
		text-decoration: none;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.whatsapp-button:hover {
		transform: translateY(-2px);
		box-shadow: 0 12px 32px rgba(37, 211, 102, 0.4);
	}

	@media (max-width: 780px) {
		.hero {
			padding: 32px 20px;
		}

		.contact-section {
			padding: 24px 20px;
		}

		.social-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
