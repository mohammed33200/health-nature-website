  // Simple exact and partial search
  const fuzzyMatch = (text: string, query: string): boolean => {
    if (!query || query.length < 1) return false;
    
    // Case-insensitive exact match (most reliable)
    const lowerText = text.toLowerCase();
    const lowerQuery = query.toLowerCase();
    
    if (lowerText.includes(lowerQuery)) return true;
    
    // Arabic character normalization
    const normalizeArabic = (str: string) => {
      return str
        .replace(/[أإآ]/g, 'ا')
        .replace(/[ة]/g, 'ه')
        .replace(/[يىئ]/g, 'ي')
        .replace(/[ؤو]/g, 'و');
    };
    
    const normalizedText = normalizeArabic(lowerText);
    const normalizedQuery = normalizeArabic(lowerQuery);
    
    if (normalizedText.includes(normalizedQuery)) return true;
    
    return false;
  };

  // Sort function
  const sortPages = (pages: typeof sitePages) => {
    const currentLang = document.documentElement.lang;
    return [...pages].sort((a, b) => {
      if (currentLang === 'ar') {
        return a.titleAr.localeCompare(b.titleAr, 'ar');
      } else {
        return a.titleEn.localeCompare(b.titleEn, 'en');
      }
    });
  };

  // Initialize search results
  function initSearchResults() {
    const container = document.getElementById('search-results-container');
    if (!container) return;

    const urlParams = new URLSearchParams(window.location.search);
    const query = urlParams.get('q') || '';

    if (!query) {
      container.innerHTML = `
        <div class="no-results">
          <h2 data-ar="الرجاء إدخال كلمة بحث" data-en="Please enter a search term">الرجاء إدخال كلمة بحث</h2>
        </div>
      `;
      return;
    }

    // Simple filtering logic
    const lowerQuery = query.toLowerCase();
    const results = sitePages.filter(page => {
      const arMatch = page.titleAr.toLowerCase().includes(lowerQuery);
      const enMatch = page.titleEn.toLowerCase().includes(lowerQuery);
      return arMatch || enMatch;
    });

    if (results.length > 0) {
      const sortedResults = sortPages(results);
      container.innerHTML = sortedResults.map(page => `
        <a href="${page.url}" class="search-result-item">
          <span class="result-title-ar">${page.titleAr}</span>
          <span class="result-title-en">${page.titleEn}</span>
        </a>
      `).join('');
    } else {
      container.innerHTML = `
        <div class="no-results">
          <h2 data-ar="لا توجد نتائج" data-en="No results found">لا توجد نتائج</h2>
          <p data-ar="لم يتم العثور على نتائج مطابقة لبحثك" data-en="No matching results were found for your search">لم يتم العثور على نتائج مطابقة لبحثك</p>
        </div>
      `;
    }
  }

  document.addEventListener('DOMContentLoaded', initSearchResults);
</script>