---
// حاسبة تصفية الكليتين — eGFR (CKD-EPI 2021)
import Layout from '../../layouts/Layout.astro';
import ToolsShell from '../../layouts/ToolsShell.astro';
---

<Layout title="حاسبة تصفية الكليتين">
  <ToolsShell>
    <section class="tool-page">
  <header class="tool-hero">
    <h1>
      <span data-ar>حاسبة تصفية الكليتين</span>
      <span data-en>eGFR Calculator</span>
    </h1>
    <p class="credit-line">CKD-EPI Creatinine Equation, 2021 (race-free)</p>
  </header>

  <article class="info-block">
    <h2><span data-ar>ما هي؟</span><span data-en>What is it?</span></h2>
    <p>
      <span data-ar>تقدّر معدل الترشيح الكبيبي (eGFR) — أدق مقياس لوظيفة الكلى — من قيمة الكرياتينين بالدم مع العمر والجنس، باستخدام معادلة CKD-EPI 2021 المحدَّثة (لا تعتمد على العرق).</span>
      <span data-en>Estimates the glomerular filtration rate (eGFR) — the best overall marker of kidney function — from serum creatinine, age, and sex, using the updated 2021 CKD-EPI equation (race-free).</span>
    </p>
  </article>

  <article class="info-block">
    <h2><span data-ar>لماذا تهم؟</span><span data-en>Why it matters</span></h2>
    <p>
      <span data-ar>قيمة الكرياتينين وحدها مضللة (تتأثر بالكتلة العضلية والعمر والجنس)، بينما eGFR يعطي صورة موحّدة عن وظيفة الكلى تُستخدم لتصنيف مرحلة المرض الكلوي المزمن، وتعديل جرعات كثير من الأدوية التي تُطرح كلويًا.</span>
      <span data-en>Creatinine alone is misleading (affected by muscle mass, age, sex), while eGFR gives a standardized picture of kidney function used to stage chronic kidney disease and adjust doses of many renally-cleared medications.</span>
    </p>
  </article>

  <form class="calc-form" id="egfr-form" novalidate>
    <label>
      <span data-ar>الكرياتينين في الدم (مجم/دل)</span><span data-en>Serum creatinine (mg/dL)</span>
      <input type="number" id="creatinine" min="0.1" max="15" step="0.01" required />
    </label>
    <label>
      <span data-ar>العمر (سنة)</span><span data-en>Age (years)</span>
      <input type="number" id="age" min="18" max="110" required />
    </label>
    <label>
      <span data-ar>الجنس</span><span data-en>Sex</span>
      <select id="sex">
        <option value="female">أنثى / Female</option>
        <option value="male">ذكر / Male</option>
      </select>
    </label>
    <div class="form-actions">
      <button type="submit">
        <span data-ar>احسب</span>
        <span data-en>Calculate</span>
      </button>
      <button type="reset" id="reset-btn" class="btn-secondary">
        <span data-ar>إعادة تعيين</span>
        <span data-en>Reset</span>
      </button>
    </div>
  </form>

  <div class="result-box" id="result" hidden>
    <p class="result-line">
      <span data-ar>eGFR: </span><span data-en>eGFR: </span>
      <strong id="egfr-out"></strong> mL/min/1.73m²
    </p>
    <p class="result-line">
      <span data-ar>المرحلة: </span><span data-en>Stage: </span>
      <strong id="stage-out"></strong>
    </p>
  </div>

  <article class="info-block">
    <h2><span data-ar>القياس الطبيعي / التصنيف</span><span data-en>Normal reference / staging</span></h2>
    <ul class="ref-list">
      <li><span data-ar>G1: ≥90 (طبيعي أو مرتفع)</span><span data-en>G1: ≥90 (normal or high)</span></li>
      <li><span data-ar>G2: 60–89 (انخفاض خفيف)</span><span data-en>G2: 60–89 (mildly decreased)</span></li>
      <li><span data-ar>G3a: 45–59 / G3b: 30–44 (انخفاض متوسط)</span><span data-en>G3a: 45–59 / G3b: 30–44 (moderately decreased)</span></li>
      <li><span data-ar>G4: 15–29 (انخفاض شديد)</span><span data-en>G4: 15–29 (severely decreased)</span></li>
      <li><span data-ar>G5: &lt;15 (فشل كلوي)</span><span data-en>G5: &lt;15 (kidney failure)</span></li>
    </ul>
  </article>

  <a class="back-link" href="/blood/">
    <span data-ar>← رجوع لمجال تحاليل الدم</span>
    <span data-en>← Back to Blood Tests &amp; Diagnostics</span>
  </a>
    </section>
  </ToolsShell>
</Layout>

<script>
  const form = document.getElementById("egfr-form") as HTMLFormElement | null;
  const creatinineInput = document.getElementById("creatinine") as HTMLInputElement | null;
  const ageInput = document.getElementById("age") as HTMLInputElement | null;
  const sexSelect = document.getElementById("sex") as HTMLSelectElement | null;
  const resultBox = document.getElementById("result") as HTMLElement | null;
  const egfrOut = document.getElementById("egfr-out") as HTMLElement | null;
  const stageOut = document.getElementById("stage-out") as HTMLElement | null;

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    if (!creatinineInput || !ageInput || !sexSelect || !resultBox || !egfrOut || !stageOut) return;

    const scr = Number(creatinineInput.value);
    const age = Number(ageInput.value);
    const sex = sexSelect.value;
    if (!scr || !age) return; // Basic validation

    let egfr: number;
    if (sex === "female") {
      const k = 0.7;
      const a = scr <= k ? -0.241 : -1.200;
      egfr = 142 * Math.pow(scr / k, a) * Math.pow(0.9938, age) * 1.012; //NOSONAR
    } else {
      const k = 0.9;
      const a = scr <= k ? -0.302 : -1.200;
      egfr = 142 * Math.pow(scr / k, a) * Math.pow(0.9938, age); //NOSONAR
    }

    let stage = "";
    if (egfr >= 90) stage = "G1";
    else if (egfr >= 60) stage = "G2";
    else if (egfr >= 45) stage = "G3a";
    else if (egfr >= 30) stage = "G3b";
    else if (egfr >= 15) stage = "G4";
    else stage = "G5";

    egfrOut.textContent = egfr.toFixed(0);
    stageOut.textContent = stage;
    resultBox.hidden = false;
  });

  form?.addEventListener("reset", () => {
    if (!resultBox || !egfrOut || !stageOut) return;
    resultBox.hidden = true;
    egfrOut.textContent = "";
    stageOut.textContent = "";
  });
</script>

<style>
  .tool-page { padding-block: 2rem; max-width: 42rem; margin-inline: auto; }
  .tool-hero h1 { display: flex; flex-direction: column; gap: .15rem; margin-bottom: .3rem; }
  .tool-hero .lang-en { font-size: .65em; opacity: .6; font-weight: 500; }
  .credit-line { font-size: .75rem; opacity: .5; font-style: italic; margin-bottom: 1.2rem; }
  .info-block { margin-bottom: 1.5rem; }
  .info-block h2 { display: flex; gap: .5rem; font-size: 1rem; margin-bottom: .4rem; }
  .info-block h2 .lang-en { opacity: .6; font-weight: 500; }
  .info-block .lang-en { display: block; font-size: .9em; opacity: .7; margin-top: .3rem; }
  .ref-list { list-style: none; padding: 0; display: grid; gap: .4rem; }
  .ref-list li { padding: .5rem .75rem; background: rgba(0,0,0,.04); border-radius: .4rem; }
  .ref-list .lang-en { display: block; font-size: .85em; opacity: .65; }

  .calc-form { display: grid; gap: 1rem; margin: 1.5rem 0; padding: 1.25rem; border: 1px solid rgba(0,0,0,.1); border-radius: .75rem; }
  .calc-form label { display: grid; gap: .3rem; font-size: .9rem; }
  .calc-form input, .calc-form select { padding: .5rem .6rem; border: 1px solid rgba(0,0,0,.2); border-radius: .4rem; font-size: 1rem; }
  .form-actions { display: flex; gap: 0.75rem; align-items: center; }
  .calc-form button { padding: .6rem 1.5rem; border: none; border-radius: .5rem; font-weight: 600; cursor: pointer; }
  .calc-form button[type="submit"] { background: #1d6f5c; color: #fff; }
  .calc-form button.btn-secondary { background: rgba(0,0,0,.08); color: inherit; }

  .result-box { padding: 1.25rem; border-radius: .75rem; background: rgba(29,111,92,.08); margin-bottom: 1.5rem; }
  .result-line { margin: .3rem 0; }
  .result-line .lang-en { opacity: .7; }

  .back-link { display: inline-block; font-size: .85rem; text-decoration: none; }
</style>
