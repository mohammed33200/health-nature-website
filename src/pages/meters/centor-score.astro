---
import Layout from "../../layouts/Layout.astro";
import ToolsShell from "../../layouts/ToolsShell.astro";
// حاسبة احتمال التهاب اللوزتين البكتيري — Centor Score
---

<Layout title="حاسبة احتمال التهاب اللوزتين البكتيري">
  <ToolsShell>
    <section class="tools-scope tool-page">
  <header class="tool-hero">
    <h1>
      <span data-ar>حاسبة احتمال التهاب اللوزتين البكتيري</span>
      <span data-en dir="ltr">Centor Score</span>
    </h1>
    <p class="credit-line">Centor et al., 1981 (McIsaac modification)</p>
  </header>

  <article class="info-block">
    <h2><span data-ar>ما هي؟</span><span data-en dir="ltr">What is it?</span></h2>
    <p>
      <span data-ar>تقدّر احتمال أن يكون التهاب الحلق ناتجًا عن بكتيريا العقديات (Strep) وليس فيروسًا، عبر 4 معايير سريرية بسيطة وتعديل بالعمر.</span>
      <span data-en dir="ltr">Estimates the likelihood that a sore throat is caused by streptococcal bacteria rather than a virus, using 4 simple clinical criteria plus an age adjustment.</span>
    </p>
  </article>

  <article class="info-block">
    <h2><span data-ar>لماذا تهم؟</span><span data-en dir="ltr">Why it matters</span></h2>
    <p>
      <span data-ar>تقلل من وصف المضادات الحيوية غير الضروري لالتهابات الحلق الفيروسية (الأغلبية)، وتوجّه من يستحق فحص المسحة أو العلاج التجريبي بالمضاد الحيوي.</span>
      <span data-en dir="ltr">Reduces unnecessary antibiotic prescribing for viral sore throats (the majority), and identifies who warrants a throat swab or empirical antibiotic treatment.</span>
    </p>
  </article>

  <form class="calc-form" id="centor-form">
    <label class="checkbox-label"><input type="checkbox" id="exudate" /> <span data-ar>إفرازات أو تورم باللوزتين (1)</span><span data-en dir="ltr">Tonsillar exudate/swelling (1)</span></label>
    <label class="checkbox-label"><input type="checkbox" id="nodes" /> <span data-ar>تضخم وألم الغدد اللمفاوية الأمامية بالرقبة (1)</span><span data-en dir="ltr">Tender anterior cervical lymph nodes (1)</span></label>
    <label class="checkbox-label"><input type="checkbox" id="fever" /> <span data-ar>حمى بالتاريخ المرضي (1)</span><span data-en dir="ltr">History of fever (1)</span></label>
    <label class="checkbox-label"><input type="checkbox" id="noCough" /> <span data-ar>غياب السعال (1)</span><span data-en dir="ltr">Absence of cough (1)</span></label>
    <label>
      <span data-ar>الفئة العمرية</span><span data-en dir="ltr">Age group</span>
      <select id="age">
        <option value="1">3–14 سنة (+1)</option>
        <option value="0">15–44 سنة (0)</option>
        <option value="-1">45 فأكثر (-1)</option>
      </select>
    </label>
    <button type="submit">
      <span data-ar>احسب</span>
      <span data-en dir="ltr">Calculate</span>
    </button>
  </form>

  <div class="result-box" id="result" hidden>
    <p class="result-line">
      <span data-ar>المجموع: </span><span data-en dir="ltr">Score: </span>
      <strong id="score-out"></strong>
    </p>
    <p class="result-line">
      <span data-ar>التوصية: </span><span data-en dir="ltr">Recommendation: </span>
      <strong id="interp-out"></strong>
    </p>
  </div>

  <article class="info-block">
    <h2><span data-ar>القياس الطبيعي / التفسير</span><span data-en dir="ltr">Reference interpretation</span></h2>
    <ul class="ref-list">
      <li><span data-ar>≤1: احتمال ضئيل — لا حاجة لفحص أو مضاد حيوي</span><span data-en dir="ltr">≤1: low probability — no test or antibiotic needed</span></li>
      <li><span data-ar>2–3: احتمال متوسط — يُنظر في فحص مسحة أو مزرعة</span><span data-en dir="ltr">2–3: intermediate — consider throat swab/culture</span></li>
      <li><span data-ar>≥4: احتمال مرتفع — يُنظر في علاج تجريبي بالمضاد الحيوي</span><span data-en dir="ltr">≥4: high probability — consider empirical antibiotic treatment</span></li>
    </ul>
  </article>

  <a class="back-link" href="/meters/">
    <span data-ar>← رجوع لمجال المؤشرات التقييمية</span>
    <span data-en dir="ltr">← Back to Assessment &amp; Risk Indices</span>
  </a>
    </section>
  </ToolsShell>
</Layout>

<script>
  const form = document.getElementById("centor-form") as HTMLFormElement;
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const ids = ["exudate", "nodes", "fever", "noCough"];
    let total = ids.reduce((sum, id) => sum + ((document.getElementById(id) as HTMLInputElement).checked ? 1 : 0), 0);
    total += Number((document.getElementById("age") as HTMLSelectElement).value);

    let interpAr = "", interpEn = "";
    if (total <= 1) { interpAr = "احتمال ضئيل"; interpEn = "Low probability"; }
    else if (total <= 3) { interpAr = "احتمال متوسط"; interpEn = "Intermediate probability"; }
    else { interpAr = "احتمال مرتفع"; interpEn = "High probability"; }

    (document.getElementById("score-out") as HTMLElement).textContent = String(total);
    (document.getElementById("interp-out") as HTMLElement).textContent = `${interpAr} / ${interpEn}`;
    (document.getElementById("result") as HTMLElement).hidden = false;
  });
</script>

<style>
  .tool-page { padding-block: 2rem; max-width: 42rem; margin-inline: auto; }
  .tool-hero h1 { display: flex; flex-direction: column; gap: .15rem; margin-bottom: .3rem; }
  .tool-hero [data-en] { font-size: .65em; opacity: .6; font-weight: 500; }
  .credit-line { font-size: .75rem; opacity: .5; font-style: italic; margin-bottom: 1.2rem; }
  .info-block { margin-bottom: 1.5rem; }
  .info-block h2 { display: flex; gap: .5rem; font-size: 1rem; margin-bottom: .4rem; }
  .info-block h2 [data-en] { opacity: .6; font-weight: 500; }
  .info-block [data-en] { display: block; font-size: .9em; opacity: .7; margin-top: .3rem; }
  .ref-list { list-style: none; padding: 0; display: grid; gap: .4rem; }
  .ref-list li { padding: .5rem .75rem; background: rgba(0,0,0,.04); border-radius: .4rem; }
  .ref-list [data-en] { display: block; font-size: .85em; opacity: .65; }

  .calc-form { display: grid; gap: .75rem; margin: 1.5rem 0; padding: 1.25rem; border: 1px solid rgba(0,0,0,.12); border-radius: .75rem; }
  .calc-form label { display: grid; gap: .3rem; font-size: .9rem; }
  .calc-form select { padding: .5rem .6rem; border: 1px solid rgba(0,0,0,.2); border-radius: .4rem; font-size: 1rem; }
  .checkbox-label { display: flex; align-items: center; gap: .5rem; font-size: .9rem; }
  .checkbox-label [data-en] { opacity: .6; font-size: .85em; }
  .calc-form button { justify-self: start; padding: .6rem 1.5rem; border: none; border-radius: .5rem; background: #1d6f5c; color: #fff; font-weight: 600; cursor: pointer; margin-top: .5rem; }
  .calc-form button [data-en] { display: block; font-size: .75em; opacity: .85; }

  .result-box { padding: 1.25rem; border-radius: .75rem; background: rgba(29,111,92,.08); margin-bottom: 1.5rem; }
  .result-line { margin: .3rem 0; }
  .result-line [data-en] { opacity: .7; }

  .back-link { display: inline-block; font-size: .85rem; text-decoration: none; }
</style>
