---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title?: string;
	description?: string;
	lang?: 'ar' | 'en';
	embed?: boolean;
}

const { title = 'SHYM365.ORG', description = "Discover our free, privacy-first health applications and tools.", lang = 'ar', embed = false } = Astro.props;

// Check for embed mode via URL parameter
const url = new URL(Astro.request.url);
const isEmbed = embed || url.searchParams.get('embed') === 'true';
---

<!doctype html>
<html lang={lang} dir={lang === 'ar' ? 'rtl' : 'ltr'} class={isEmbed ? 'embed-mode' : ''}>
	<head>
		<meta charset="utf-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<slot name="head" />
		<style is:inline>
			/* Global layout styles */
			body {
				margin: 0;
				padding: 0;
				min-height: 100vh;
				display: flex;
				flex-direction: column;
			}

			main {
				flex: 1;
				width: 100%;
				max-width: 100%;
				overflow-x: hidden;
			}

			/* Ensure proper spacing */
			.site-header {
				flex-shrink: 0;
			}

			.site-footer {
				flex-shrink: 0;
			}

			/* Embed mode styles */
			.embed-mode body {
				margin: 0;
				padding: 0;
				overflow-x: hidden;
			}
			.embed-mode header,
			.embed-mode footer {
				display: none !important;
			}
			.embed-mode main {
				margin: 0;
				padding: 20px;
				max-width: 100%;
			}
			.embed-mode .site-footer {
				display: none !important;
			}

			/* Print styles */
			@media print {
				header, footer, .site-footer, .back-link, .et-hero, .info-section, .disclaimer {
					display: none !important;
				}
				body {
					background: white !important;
					color: black !important;
				}
				main {
					margin: 0 !important;
					padding: 0 !important;
				}
				.calc-card, .result {
					page-break-inside: avoid;
					border: 1px solid #ccc !important;
					box-shadow: none !important;
				}
				.et-result {
					display: block !important;
					background: white !important;
					border: 2px solid #000 !important;
					padding: 20px !important;
					margin: 20px 0 !important;
				}
				button, input[type="button"], .btn-calc, .btn-ghost {
					display: none !important;
				}
			}
		</style>
	</head>
	<body>
		{!isEmbed && <Header />}
		<main>
			<slot />
		</main>
		{!isEmbed && <Footer />}
	</body>
</html>
