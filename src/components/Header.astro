		{ titleAr: 'الأنماط البصرية', titleEn: 'Visual Patterns', url: '/memory/visual-patterns' },
		{ titleAr: 'اختبارات الذاكرة واليقظة', titleEn: 'Memory, Vigilance & Attention Tests', url: '/memory' },
		{ titleAr: 'مقياس اكتئابية الذاكرة (ASRS)', titleEn: 'ASRS', url: '/tests/asrs' },
		{ titleAr: 'مقياس اكتئابية الكحول (AUDIT-C)', titleEn: 'AUDIT-C', url: '/tests/audit-c' },
		{ titleAr: 'مقياس كاج (CAGE)', titleEn: 'CAGE', url: '/tests/cage' },
		{ titleAr: 'مقياس القلق والاكتئاب والاكتئاب (DASS-21)', titleEn: 'DASS-21', url: '/tests/dass21' },
		{ titleAr: 'مقياس القلق المعمم (GAD-7)', titleEn: 'GAD-7', url: '/tests/gad7' },
		{ titleAr: 'مقياس اضطراب ما بعد الصدمة (PCL-5)', titleEn: 'PCL-5', url: '/tests/pcl5' },
		{ titleAr: 'مقياس اضطراب ما بعد الصدمة (PC-PTSD-5)', titleEn: 'PC-PTSD-5', url: '/tests/pcptsd5' },
		{ titleAr: 'مقياس الاكتئاب (PHQ-9)', titleEn: 'PHQ-9', url: '/tests/phq9' },
		{ titleAr: 'مقياس الإجهاد المدني (PSS-10)', titleEn: 'PSS-10', url: '/tests/pss10' },
		{ titleAr: 'مقياس تقدير الذات (روزنبرغ)', titleEn: 'Rosenberg', url: '/tests/rosenberg' },
		{ titleAr: 'مقياس اضطراب الأكل (SCOFF)', titleEn: 'SCOFF', url: '/tests/scoff' },
		{ titleAr: 'مقياس رفاهية منظمة الصحة العالمية (WHO-5)', titleEn: 'WHO-5', url: '/tests/who5' },
		{ titleAr: 'تنظيف الروابط', titleEn: 'URL Cleaner', url: '/url-cleaner' },
		{ titleAr: 'حاسبة جرعة الأدوية للأطفال', titleEn: 'Pediatric Dosage Calculator', url: '/pediatric-dosage-calculator' },
	];

	// Sort pages alphabetically based on current language
	const sortPages = (pages: typeof sitePages) => {
		const currentLang = document.documentElement.lang;
		return [...pages].sort((a, b) => {
			if (currentLang === 'ar') {
				return a.titleAr.localeCompare(b.titleAr, 'ar');
			} else {
				return a.titleEn.localeCompare(b.titleEn, 'en');
			}
		});
	};

	let sortedSitePages = sortPages(sitePages);

	const searchInput = document.getElementById('site-search') as HTMLInputElement | null;
	const searchToggle = document.getElementById('search-toggle') as HTMLButtonElement | null;
	const searchResults = document.getElementById('search-results') as HTMLElement | null;
	let searchExpanded = false;

	if (searchToggle && searchInput && searchResults) {
		searchToggle.addEventListener('click', () => {
			searchExpanded = !searchExpanded;
			if (searchExpanded) {
				searchInput.classList.add('active');
				searchInput.focus();
				// Clear input and show all sorted results when search is opened
				searchInput.value = '';
				sortedSitePages = sortPages(sitePages);
				searchResults.innerHTML = sortedSitePages.map(page => `
					<a href="${page.url}" class="search-result-item">
						<span class="result-title-ar">${page.titleAr}</span>
						<span class="result-title-en">${page.titleEn}</span>
					</a>
				`).join('');
				searchResults.classList.add('active');
			} else {
				searchInput.classList.remove('active');
				searchResults.classList.remove('active');
				searchResults.innerHTML = '';
			}
		});

		searchInput.addEventListener('input', (e) => {
			const query = (e.target as HTMLInputElement).value.trim();
			
			// Simple filtering logic
			if (query.length === 0) {
				// Show all pages when search is empty
				sortedSitePages = sortPages(sitePages);
				searchResults.innerHTML = sortedSitePages.map(page => `
					<a href="${page.url}" class="search-result-item">
						<span class="result-title-ar">${page.titleAr}</span>
						<span class="result-title-en">${page.titleEn}</span>
					</a>
				`).join('');
				searchResults.classList.add('active');
				return;
			}

			// Filter pages based on search query
			const lowerQuery = query.toLowerCase();
			const results = sitePages.filter(page => {
				const arMatch = page.titleAr.toLowerCase().includes(lowerQuery);
				const enMatch = page.titleEn.toLowerCase().includes(lowerQuery);
				return arMatch || enMatch;
			});

			if (results.length > 0) {
				const sortedResults = sortPages(results);
				searchResults.innerHTML = sortedResults.map(page => `
					<a href="${page.url}" class="search-result-item">
						<span class="result-title-ar">${page.titleAr}</span>
						<span class="result-title-en">${page.titleEn}</span>
					</a>
				`).join('');
				searchResults.classList.add('active');
			} else {
				searchResults.innerHTML = `
					<div class="search-no-results">
						<span data-ar>لا توجد نتائج</span>
						<span data-en>No results found</span>
					</div>
				`;
				searchResults.classList.add('active');
			}
		});

		// Keyboard navigation
		searchInput.addEventListener('keydown', (e) => {
			if (e.key === 'Enter') {
				const query = searchInput.value.trim();
				if (query) {
					// Redirect to search results page with query parameter
					window.location.href = `/search?q=${encodeURIComponent(query)}`;
				}
			}
		});

		// Close search when clicking outside
		document.addEventListener('click', (e) => {
			const target = e.target as HTMLElement;
			if (!target.closest('.search-container')) {
				searchExpanded = false;
				searchInput.classList.remove('active');
				searchResults.classList.remove('active');
				searchInput.value = '';
			}
		});
	}

	window.addEventListener('DOMContentLoaded', () => {
		const initialLang = getInitialLang();
		setLanguage(initialLang); // Dispatch event on initial load
		const toggle = document.getElementById('language-toggle');
		if (toggle) {
			toggle.addEventListener('click', () => {
				const nextLang = document.documentElement.lang === 'ar' ? 'en' : 'ar';
				setLanguage(nextLang);
			});
		}

		window.addEventListener('languageChanged', (event) => {
			const customEvent = event as CustomEvent<{ lang: string }>;
			const lang = customEvent.detail?.lang;
			if (lang === 'ar' || lang === 'en') {
				setLanguage(lang, true);
				// Re-sort pages when language changes
				sortedSitePages = sortPages(sitePages);
				// Update search results if they're visible
				if (searchExpanded && searchInput.value.trim() === '') {
					searchResults.innerHTML = sortedSitePages.map(page => `
						<a href="${page.url}" class="search-result-item">
							<span class="result-title-ar">${page.titleAr}</span>
							<span class="result-title-en">${page.titleEn}</span>
						</a>
					`).join('');
				}
			}
		});
	});
</script>

