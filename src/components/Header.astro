<script>
	const getInitialLang = () => {
		const saved = localStorage.getItem('siteLang');
		return saved === 'ar' ? 'ar' : 'en';
	};

	const setLanguage = (lang, suppressEvent = false) => {
		document.documentElement.lang = lang;
		document.documentElement.dir = lang === 'ar' ? 'rtl' : 'ltr';
		document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((node) => {
			const text = node.dataset[lang];
			if (text) node.textContent = text;
		});
		document.querySelectorAll<HTMLElement>('[data-i18n-placeholder]').forEach((node) => {
			const text = node.dataset[lang + 'Placeholder'];
			if (text) node.setAttribute('placeholder', text);
		});
		const toggle = document.getElementById('language-toggle');
		if (toggle) toggle.textContent = lang === 'ar' ? 'EN' : 'عربي';
		localStorage.setItem('siteLang', lang);
		if (!suppressEvent) {
			window.dispatchEvent(new CustomEvent('languageChanged', { detail: { lang: lang } }));
		}
	};

	// Site search functionality
	// Simple exact and partial search
	const fuzzyMatch = (text: string, query: string): boolean => {
		if (!query || query.length < 1) return false;
		
		// Case-insensitive exact match (most reliable)
		const lowerText = text.toLowerCase();
		const lowerQuery = query.toLowerCase();
		
		if (lowerText.includes(lowerQuery)) return true;
		
		// Arabic character normalization
		const normalizeArabic = (str: string) => {
			return str
				.replace(/[أإآ]/g, 'ا')
				.replace(/[ة]/g, 'ه')
				.replace(/[يىئ]/g, 'ي')
				.replace(/[ؤو]/g, 'و');
		};
		
		const normalizedText = normalizeArabic(lowerText);
		const normalizedQuery = normalizeArabic(lowerQuery);
		
		if (normalizedText.includes(normalizedQuery)) return true;
		
		return false;
	};

