<style>
	.site-footer {
		padding: 42px 32px 28px;
		margin-top: 32px;
		background: radial-gradient(circle at top left, rgba(135, 168, 118, 0.16), transparent 35%),
			rgba(247, 251, 247, 0.96);
		border-radius: 32px;
		box-shadow: 0 24px 60px rgba(15, 23, 42, 0.08);
		border: 1px solid rgba(56, 132, 81, 0.08);
	}

	.footer-top {
		display: grid;
		grid-template-columns: minmax(260px, 1.5fr) minmax(220px, 1fr);
		gap: 32px;
		align-items: start;
		padding-bottom: 28px;
		border-bottom: 1px solid rgba(15, 23, 42, 0.06);
	}

	.eyebrow {
		margin: 0 0 10px;
		font-size: 0.82rem;
		font-weight: 700;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: #1f5d39;
	}

	h2 {
		margin: 0 0 12px;
		font-size: clamp(1.8rem, 2.1vw, 2.2rem);
		line-height: 1.05;
	}

	.footer-top p,
	.footer-grid p,
		.footer-bottom p {
		margin: 0;
		color: #475569;
		font-size: 1rem;
		line-height: 1.75;
	}

	.social-links {
		display: grid;
		grid-template-columns: repeat(2, minmax(130px, auto));
		gap: 14px 16px;
		justify-content: start;
		align-items: center;
	}

	.social-links a,
	.footer-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 12px 18px;
		background: rgba(255, 255, 255, 0.92);
		border-radius: 999px;
		border: 1px solid rgba(56, 132, 81, 0.14);
		text-decoration: none;
		color: #134e39;
		font-weight: 700;
		letter-spacing: 0.01em;
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.5);
		transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
	}

	.social-links a:hover,
	.footer-link:hover {
		transform: translateY(-2px);
		box-shadow: 0 16px 32px rgba(15, 23, 42, 0.12);
		background: #f8fdf6;
	}

	.footer-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(200px, 1fr));
		gap: 24px;
		margin-top: 32px;
	}

	.footer-grid > div {
		padding: 22px 20px;
		background: rgba(255, 255, 255, 0.92);
		border-radius: 22px;
		border: 1px solid rgba(56, 132, 81, 0.08);
	}

	.footer-link {
		display: inline-flex;
		width: fit-content;
		margin-top: 12px;
	}

	.contact-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin-top: 16px;
	}

	.privacy-link {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		margin-top: 0;
	}

	.privacy-icon {
		flex-shrink: 0;
		width: 18px;
		height: 18px;
		stroke-width: 2.2;
	}

	.footer-bottom {
		margin-top: 30px;
		text-align: center;
		color: #5f6f7f;
		font-size: 0.95rem;
	}

	@media (max-width: 920px) {
		.footer-top,
		.footer-grid {
			grid-template-columns: 1fr;
		}
		.footer-top {
			padding-bottom: 24px;
		}
	}

	@media (max-width: 560px) {
		.social-links {
			grid-template-columns: 1fr;
		}
	}
</style>
